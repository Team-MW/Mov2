---
export const prerender = false;

import Layout from "@layouts/Layout.astro";
import AdminTopbar from "@components/admin/AdminTopbar.astro";
import JotformSubmissionsView from "@components/islands/admin/JotformSubmissionsView.jsx";
import { SITE } from "@/lib/site";
import { isAuthenticated } from "@/lib/auth";
import {
  getJotformApiKey,
  listMarcheDeMoForms,
  fetchFormSubmissions,
  flattenAnswers,
  getFormByKey,
} from "@/lib/jotform";

if (!(await isAuthenticated(Astro.cookies))) {
  return Astro.redirect("/admin/login");
}

const configured = !!getJotformApiKey();
const { forms: formMetas, error: listError } = await listMarcheDeMoForms();

const requested =
  Astro.url.searchParams.get("form") || formMetas[0]?.key || "recrutement";
const initialForm = getFormByKey(formMetas, requested);

function previewFromAnswers(
  answers: ReturnType<typeof flattenAnswers>
): string {
  const prefer = [
    /nom/i,
    /name/i,
    /email/i,
    /mail/i,
    /poste/i,
    /téléphone|telephone|phone/i,
  ];
  for (const re of prefer) {
    const hit = answers.find(
      (a) => re.test(a.label) && a.value
    );
    if (hit) return hit.value;
  }
  return answers.find((a) => a.value)?.value ?? "";
}

const forms = await Promise.all(
  formMetas.map(async (meta) => {
    if (!configured) {
      return {
        key: meta.key,
        label: meta.label,
        description: meta.description,
        page: meta.page,
        total: meta.count ?? 0,
        submissions: [],
        error: null,
        disabled: meta.status === "DISABLED",
      };
    }
    const { submissions, total, error } = await fetchFormSubmissions(meta.id, {
      limit: 50,
    });
    return {
      key: meta.key,
      label: meta.label,
      description: meta.description,
      page: meta.page,
      total: total || meta.count || 0,
      error: error ?? null,
      disabled: meta.status === "DISABLED",
      submissions: submissions.map((s) => {
        const answers = flattenAnswers(s.answers || {});
        return {
          id: s.id,
          created_at: s.created_at,
          status: s.status,
          preview: previewFromAnswers(answers),
          answers,
        };
      }),
    };
  })
);

const totalAll = forms.reduce((n, f) => n + (f.total || 0), 0);
---

<Layout
  title={`Formulaires · ${SITE.name} — Admin`}
  description="Toutes les réponses aux formulaires Marché de Mo'."
  noIndex
  hideChrome
>
  <div class="min-h-screen bg-white">
    <AdminTopbar current="formulaires" subtitle="Formulaires" />

    <main class="container-mo py-8 md:py-12">
      <section class="mb-8">
        <span class="eyebrow">Jotform · Marché de Mo'</span>
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mt-3">
          <div>
            <h1 class="display-sm leading-tight">
              Réponses aux formulaires
            </h1>
            <p class="mt-2 text-[14px] text-neutral-500">
              {forms.length} formulaire{forms.length > 1 ? "s" : ""} · {totalAll} réponse{totalAll > 1 ? "s" : ""} au total
            </p>
          </div>
          <p class="text-[13px] text-neutral-500 max-w-md md:text-right">
            Recrutement, franchise, fidélité et tout autre formulaire Marché de Mo' —
            synchronisés en direct depuis Jotform.
          </p>
        </div>
      </section>

      {listError && configured && (
        <div class="mb-6 bg-orange-50 border border-orange-200 text-orange-900 rounded-2xl p-4 text-[13.5px]">
          {listError}
        </div>
      )}

      <JotformSubmissionsView
        client:load
        forms={forms}
        initialKey={initialForm?.key || "recrutement"}
        configured={configured}
        setupHint={listError && !configured ? listError : null}
      />
    </main>
  </div>
</Layout>
