---
import Layout from "@layouts/Layout.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import { SITE } from "@/lib/site";
import { breadcrumbSchema } from "@/lib/schema";
import {
  CATALOGUES,
  formatWeekLabel,
  formatWeekShort,
} from "@/lib/catalogues";

const bc = breadcrumbSchema([{ name: "Catalogues", url: "/catalogue" }]);

const tiles = CATALOGUES.map((c) => ({
  ...c,
  weekLabel: formatWeekLabel(c.periode),
  weekShort: formatWeekShort(c.periode),
}));
---

<Layout
  title={`Catalogues en ligne : toutes nos offres · ${SITE.name}`}
  description="Découvrez les offres Marché de Mo' hebdomadaires et futures. Parcourez nos catalogues en ligne et restez informés des bons plans à Toulouse."
  schema={bc}
>
  <Breadcrumb items={[{ name: "Catalogues" }]} />

  <!-- Hero -->
  <section class="bg-noir-section text-white relative overflow-hidden">
    <img
      src="/logos/favicon-marchedemo-contourwh.png"
      alt=""
      aria-hidden="true"
      class="absolute -right-16 top-0 w-[420px] opacity-[0.06] pointer-events-none select-none"
    />
    <div class="container-mo relative z-10 py-14 md:py-16">
      <span class="eyebrow !text-vert-light">Catalogues</span>
      <h1 class="display-xl mt-4 text-balance max-w-3xl" data-split-reveal>
        Nos catalogues
      </h1>
      <p class="mt-3 text-[22px] md:text-[28px] font-soft font-bold text-vert-light">
        Toutes les offres Marché de Mo'
      </p>
      <p class="mt-6 max-w-2xl text-[16.5px] text-white/80 leading-relaxed">
        Consultez les catalogues de la semaine passée, en cours et à venir —
        comme en magasin, directement en ligne.
      </p>
    </div>
  </section>

  <!-- Tiles catalogues -->
  <section class="section bg-blanc">
    <div class="container-mo">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10">
        <div>
          <span class="eyebrow">À feuilleter</span>
          <h2 class="display-md mt-3 text-balance">3 catalogues à consulter</h2>
        </div>
        <a href="/promos" class="text-[14px] font-bold text-vert hover:underline">
          Voir toutes les promos →
        </a>
      </div>

      <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
        {tiles.map((tile, i) => (
          <article
            class:list={[
              "group relative flex flex-col bg-white rounded-3xl overflow-hidden border border-black/5 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1",
              tile.periode === "current" && "ring-2 ring-vert/40",
            ]}
          >
            {tile.periode === "current" && (
              <span class="absolute top-4 left-4 z-10 px-3 py-1 rounded-full bg-vert text-white text-[11px] font-bold uppercase tracking-wider shadow-md">
                En cours
              </span>
            )}

            <a href={`/catalogue/${tile.slug}`} class="block relative aspect-[3/4] overflow-hidden bg-neutral-100">
              <div
                class="absolute inset-0 opacity-90"
                style={`background: linear-gradient(160deg, ${tile.accent}22 0%, transparent 55%), #f5f5f5`}
              />
              <img
                src={tile.cover}
                alt={tile.coverAlt}
                class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                loading={i === 0 ? "eager" : "lazy"}
              />
              <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-black/50 to-transparent" />
              <div class="absolute bottom-4 left-4 right-4">
                <p class="text-white/90 text-[12px] font-bold uppercase tracking-wider">
                  {tile.weekShort}
                </p>
              </div>
            </a>

            <div class="flex flex-col flex-1 p-6">
              <h3 class="font-soft font-bold text-[20px] leading-tight text-neutral-900">
                {tile.titre}
              </h3>
              <p class="mt-2 text-[13px] font-semibold text-neutral-500">
                {tile.weekLabel}
              </p>
              <p class="mt-3 text-[14.5px] text-neutral-600 leading-relaxed flex-1">
                {tile.description}
              </p>
              <a
                href={`/catalogue/${tile.slug}`}
                class="mt-6 inline-flex items-center justify-center gap-2 btn btn-primary w-full"
                style={tile.periode !== "current" ? `background:${tile.accent};border-color:${tile.accent}` : undefined}
              >
                {tile.ctaLabel}
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M5 12h14M13 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- WhatsApp teaser -->
  <section class="section-sm bg-white border-t border-black/5">
    <div class="container-mo flex flex-col md:flex-row items-center gap-8 justify-between">
      <div class="max-w-xl">
        <span class="eyebrow">En avant-première</span>
        <h2 class="display-sm mt-3 text-balance">
          Le catalogue sur <span class="text-[#25D366]">WhatsApp</span>
        </h2>
        <p class="mt-3 text-[15px] text-neutral-600 leading-relaxed">
          Recevez le catalogue numérique, les alertes arrivages et les réductions
          exclusives directement sur votre téléphone.
        </p>
      </div>
      <a
        href="https://whatsapp.com/channel/0029Vb8ix0yI1rcr1BkAll1I"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 bg-[#25D366] hover:bg-[#1DA851] text-white font-bold px-7 py-4 rounded-2xl transition-all hover:-translate-y-0.5 shadow-lg shadow-[#25D366]/25 shrink-0"
      >
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Rejoindre le canal
      </a>
    </div>
  </section>
</Layout>
