---
import Layout from "@layouts/Layout.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import Stats from "@components/Stats.astro";
import FAQAccordion from "@components/FAQAccordion.astro";
import { SITE, MAGASINS } from "@/lib/site";
import { FAQ_HOME } from "@/lib/faqs";
import { breadcrumbSchema, organizationSchema } from "@/lib/schema";

const bc = breadcrumbSchema([{ name: "Notre enseigne", url: "/notre-enseigne" }]);

/* Timeline chronologique — dates réelles du parcours du groupe. */
const TIMELINE = [
  {
    date: "1957",
    label: "L'origine",
    detail:
      "Ouverture de la première épicerie familiale.",
  },
  {
    date: "1961",
    label: "La boucherie",
    detail:
      "Les bouchers rejoignent l'épicerie familiale.",
  },
  {
    date: "1990",
    label: "L'expansion",
    detail:
      "Succès familial avec l'ouverture de plus de 3 magasins.",
  },
  {
    date: "2020",
    label: "Premier grand format",
    detail:
      "Ouverture du premier magasin d'Occitanie à Portet-sur-Garonne avec 500 m² d'espace de vente.",
  },
  {
    date: "2024",
    label: "Le plus grand supermarché du Mirail",
    detail:
      "Marché de Mo' devient le plus grand supermarché du Mirail avec plus de 1 200 m² d'espace de vente.",
  },
] as const;

/* Les 3 piliers fondateurs du groupe — identité, pas slogan. */
const PILIERS = [
  {
    titre: "Qualité",
    detail:
      "Boucherie sur carcasse, fruits & légumes livrés chaque matin, épices importées en direct — pas de grossiste intermédiaire. La qualité n'est pas une option, c'est ce qui justifie le prix.",
  },
  {
    titre: "Engagement",
    detail:
      "Dons réguliers aux banques alimentaires de Haute-Garonne, soutien aux associations sportives locales, partenariats avec les structures pour personnes âgées. On rend à la ville ce qu'elle nous donne.",
  },
  {
    titre: "Inclusion",
    detail:
      "90 % de notre équipe n'avait pas d'emploi avant. 24 salariés entre 19 et 56 ans. Pas de diplôme exigé, pas de CV formel demandé — seule la motivation compte.",
  },
] as const;
---

<Layout
  title={`Notre enseigne — L'histoire du Marché de Mo' · ${SITE.name}`}
  description="Le Marché de Mo' est né d'une conviction : les saveurs du monde doivent être accessibles à tous. Retour sur notre histoire, notre équipe et notre ambition."
  faqItems={FAQ_HOME}
  schema={[bc, organizationSchema()]}
>
  <Breadcrumb items={[{ name: "Notre enseigne" }]} />

  <!-- HERO — two-column on desktop : copy (left) + brand lockup (right).
       The previous version had a faint favicon watermark floating outside
       the container which left a large empty void on the right. We now
       fill it with a real on-brand logo card so the section composition
       is balanced. On mobile the lockup stacks above the copy. -->
  <section class="bg-blanc relative overflow-hidden pt-2 pb-10 md:pb-12">
    <div class="container-mo relative grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <div class="lg:col-span-7">
        <span class="eyebrow">Notre histoire</span>
        <h1 class="display-xl mt-4 text-balance" data-split-reveal>
          Une famille.<br/>
          Une <span class="text-vert">vision</span>.<br/>
          20 000+ références.
        </h1>
        <p class="mt-6 max-w-2xl text-[16px] md:text-[17px] text-neutral-600 leading-relaxed">
          Le Marché de Mo' est le fruit d'une histoire familiale dédiée au commerce.
          Aujourd'hui à Toulouse Sud, <strong>20 000+ références</strong> et une équipe de
          <strong>24 passionnés</strong> racontent la même histoire : celle d'un
          commerçant indépendant, engagé, qui croit aux saveurs du monde.
        </p>
      </div>

      <!-- Brand lockup — radial vert glow + ring + logo. On mobile we
           show a smaller, centered version above the copy. -->
      <aside
        class="lg:col-span-5 order-first lg:order-none flex justify-center lg:justify-end"
        aria-hidden="true"
      >
        <div class="notre-enseigne-brand-card relative aspect-square w-[180px] sm:w-[220px] md:w-[260px] lg:w-[340px] xl:w-[380px] rounded-full flex items-center justify-center select-none">
          <img
            src="/logos/logo-marchedemo-rond-contourgreen.png"
            alt=""
            class="relative z-10 w-[78%] h-[78%] object-contain drop-shadow-[0_18px_36px_rgba(28,107,53,0.25)]"
            loading="eager"
            fetchpriority="high"
            width="380"
            height="380"
          />
        </div>
      </aside>
    </div>

    <style>
      /* Soft radial brand halo + concentric ring. We use a pseudo-element
         so the halo can extend beyond the logo's bounding box without
         affecting layout. The ring is a thin vert outline for cohesion
         with the rounded green logo. */
      .notre-enseigne-brand-card::before {
        content: "";
        position: absolute;
        inset: -8%;
        border-radius: 9999px;
        background:
          radial-gradient(circle at center,
            rgba(28, 107, 53, 0.18) 0%,
            rgba(28, 107, 53, 0.06) 35%,
            rgba(28, 107, 53, 0) 70%);
        z-index: 0;
        pointer-events: none;
      }
      .notre-enseigne-brand-card::after {
        content: "";
        position: absolute;
        inset: 6%;
        border-radius: 9999px;
        border: 1px dashed rgba(28, 107, 53, 0.25);
        z-index: 0;
        pointer-events: none;
        animation: notre-enseigne-spin 60s linear infinite;
      }
      @keyframes notre-enseigne-spin {
        to { transform: rotate(360deg); }
      }
      @media (prefers-reduced-motion: reduce) {
        .notre-enseigne-brand-card::after { animation: none; }
      }
    </style>
  </section>

  <Stats />

  <!-- STORY -->
  <section class="section bg-blanc">
    <div class="container-mo grid lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      <div class="lg:col-span-5 lg:sticky lg:top-28">
        <div class="relative aspect-square rounded-[36px] overflow-hidden shadow-card bg-noir-softer reveal reveal-mask">
          <img
            src="/images/franchise-hero.avif"
            alt="L'équipe du Marché de Mo'"
            class="w-full h-full object-cover"
            loading="lazy"
            decoding="async"
            width="800"
            height="800"
          />
        </div>
        <div class="mt-6 bg-white rounded-2xl p-5">
          <p class="text-[13px] uppercase tracking-wider text-neutral-500 font-bold">Fondateur</p>
          <p class="font-soft font-bold text-[22px] mt-1">Le fondateur</p>
          <p class="text-[13.5px] text-neutral-600 mt-2">
            Lauréat 2024 · Réseau Entreprendre Occitanie · Parrainé par le
            directeur d'Auchan Gramont.
          </p>
        </div>
      </div>

      <div class="lg:col-span-7 space-y-10">
        <div>
          <span class="eyebrow">Chapitre 1 — Mo'</span>
          <h2 class="display-md mt-4">Mo', c'était <span class="text-vert">Mohammed</span>.</h2>
          <p class="mt-4 text-[15.5px] text-neutral-700 leading-relaxed">
            Le patriarche. Le père d'une famille de commerçants passionnés dont est
            est issu le fondateur. C'est en son hommage — et pour perpétuer cet esprit
            de transmission — que l'enseigne porte son nom.
          </p>
        </div>

        <div>
          <span class="eyebrow">Chapitre 2 — Cépière</span>
          <h2 class="display-md mt-4">Votre supermarché au cœur de Toulouse.</h2>
          <p class="mt-4 text-[15.5px] text-neutral-700 leading-relaxed">
            Marché de Mo' a ouvert ses portes au <strong>5 rue Joachim du Bellay</strong>,
            dans les locaux du centre commercial L'Hippodrome (Toulouse Sud — Cépière).
            Avec 1 200 m² de surface de vente, plus de 20 000 références et une équipe
            dévouée, c'est aujourd'hui le plus grand supermarché ethnique d'Occitanie.
          </p>
        </div>

        <div>
          <span class="eyebrow">Chapitre 3 — Demain</span>
          <h2 class="display-md mt-4">Et après ?</h2>
          <p class="mt-4 text-[15.5px] text-neutral-700 leading-relaxed">
            Le développement de nouvelles offres et de nouveaux services se poursuit.
            Mais avant toute expansion, notre priorité reste la même :
            <strong>qualité, engagement, inclusion</strong>. Notre magasin est conçu pour
            être un lieu de lien social — pas seulement un point de vente.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- TIMELINE -->
  <section class="section bg-white">
    <div class="container-mo">
      <div class="max-w-2xl">
        <span class="eyebrow">Chronologie</span>
        <h2 class="display-md mt-4 text-balance">
          Notre histoire. <span class="text-vert">Notre vision.</span> Une trajectoire.
        </h2>
        <p class="mt-5 text-[15.5px] text-neutral-600 leading-relaxed">
          Les dates clés qui ont construit le supermarché Marché de Mo' à Toulouse.
        </p>
      </div>

      <ol class="mt-14 relative pl-6 md:pl-0 md:max-w-3xl md:mx-auto">
        <span class="absolute left-2 md:left-1/2 md:-translate-x-1/2 top-2 bottom-2 w-[2px] bg-vert/25" aria-hidden="true"></span>
        {TIMELINE.map((t, i) => (
          <li
            class:list={[
              "relative mb-10 last:mb-0 md:grid md:grid-cols-2 md:gap-10 reveal",
              i % 2 === 0 ? "reveal-left" : "reveal-right",
            ]}
            style={`--reveal-delay: ${i * 80}ms`}
          >
            <span
              class="absolute left-2 md:left-1/2 md:-translate-x-1/2 top-2 w-3 h-3 rounded-full bg-vert ring-4 ring-white shadow"
              aria-hidden="true"
            ></span>

            {i % 2 === 0 ? (
              <>
                <div class="md:text-right md:pr-10 pl-6 md:pl-0">
                  <p class="text-[13px] uppercase tracking-wider text-vert font-bold">{t.date}</p>
                  <h3 class="font-soft font-bold text-[22px] mt-1">{t.label}</h3>
                </div>
                <div class="mt-2 md:mt-0 md:pl-10 pl-6 md:border-l md:border-vert/20">
                  <p class="text-[15px] text-neutral-700 leading-relaxed">{t.detail}</p>
                </div>
              </>
            ) : (
              <>
                <div class="md:pr-10 md:text-right md:order-1 hidden md:block">
                  <p class="text-[15px] text-neutral-700 leading-relaxed">{t.detail}</p>
                </div>
                <div class="md:pl-10 md:order-2 pl-6">
                  <p class="text-[13px] uppercase tracking-wider text-vert font-bold">{t.date}</p>
                  <h3 class="font-soft font-bold text-[22px] mt-1">{t.label}</h3>
                  <p class="text-[15px] text-neutral-700 leading-relaxed mt-2 md:hidden">{t.detail}</p>
                </div>
              </>
            )}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- PILIERS — 3 valeurs fondatrices -->
  <section class="section bg-blanc">
    <div class="container-mo">
      <div class="max-w-2xl">
        <span class="eyebrow">Nos 3 piliers</span>
        <h2 class="display-md mt-4 text-balance">
          Notre ADN ne change pas. <span class="text-vert">Ni hier, ni demain.</span>
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
        {PILIERS.map((p, i) => (
          <article
            class="bg-white rounded-3xl p-7 md:p-8 reveal transition-all hover:-translate-y-1 hover:shadow-card"
            style={`--reveal-delay: ${i * 90}ms`}
          >
            <h3 class="font-soft font-bold text-[24px] mt-5">{p.titre}</h3>
            <p class="mt-3 text-[14.5px] text-neutral-700 leading-relaxed">{p.detail}</p>
          </article>
        ))}
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a href="/nos-engagements" class="btn btn-secondary">
          Voir nos engagements en détail
        </a>
        <a href="/recrutement" class="text-[14px] font-bold text-vert hover:underline underline-offset-4">
          Nous rejoindre →
        </a>
      </div>
    </div>
  </section>

  <!-- CHIFFRES ENGAGEMENTS -->
  <section class="section bg-noir-section overflow-hidden py-16">
    <div class="container-mo mb-12">
      <span class="eyebrow !text-vert-light">En chiffres</span>
      <h2 class="display-lg mt-4 text-balance max-w-3xl !text-white">
        Le Marché de Mo', <span class="text-vert-light">c'est aussi</span> :
      </h2>
    </div>

    <div class="stats-marquee relative w-full overflow-hidden" aria-hidden="true">
      <div class="stats-marquee__track flex gap-12 md:gap-20 whitespace-nowrap items-center will-change-transform">
        {/* First set */}
        <div class="stats-marquee__item flex items-center gap-4 shrink-0">
          <div class="stat-number !text-white !text-[60px] md:!text-[80px] font-soft font-bold">24</div>
          <div class="font-bold text-[14px] md:text-[16px] uppercase tracking-wide text-neutral-300">salariés engagés</div>
        </div>
        <div class="stats-marquee__puce"></div>
        <div class="stats-marquee__item flex items-center gap-4 shrink-0">
          <div class="stat-number !text-white !text-[60px] md:!text-[80px] font-soft font-bold">90<span class="text-vert-light text-[0.7em]">%</span></div>
          <div class="font-bold text-[14px] md:text-[16px] uppercase tracking-wide text-neutral-300">sans emploi avant</div>
        </div>
        <div class="stats-marquee__puce"></div>
        <div class="stats-marquee__item flex items-center gap-4 shrink-0">
          <div class="stat-number !text-white !text-[60px] md:!text-[80px] font-soft font-bold">120<span class="text-vert-light text-[0.7em]">+</span></div>
          <div class="font-bold text-[14px] md:text-[16px] uppercase tracking-wide text-neutral-300">fruits exotiques</div>
        </div>
        <div class="stats-marquee__puce"></div>
        <div class="stats-marquee__item flex items-center gap-4 shrink-0">
          <div class="stat-number !text-white !text-[60px] md:!text-[80px] font-soft font-bold">19 – 56</div>
          <div class="font-bold text-[14px] md:text-[16px] uppercase tracking-wide text-neutral-300">ans, notre équipe</div>
        </div>
        <div class="stats-marquee__puce"></div>

        {/* Second set (duplicate for seamless loop) */}
        <div class="stats-marquee__item flex items-center gap-4 shrink-0">
          <div class="stat-number !text-white !text-[60px] md:!text-[80px] font-soft font-bold">24</div>
          <div class="font-bold text-[14px] md:text-[16px] uppercase tracking-wide text-neutral-300">salariés engagés</div>
        </div>
        <div class="stats-marquee__puce"></div>
        <div class="stats-marquee__item flex items-center gap-4 shrink-0">
          <div class="stat-number !text-white !text-[60px] md:!text-[80px] font-soft font-bold">90<span class="text-vert-light text-[0.7em]">%</span></div>
          <div class="font-bold text-[14px] md:text-[16px] uppercase tracking-wide text-neutral-300">sans emploi avant</div>
        </div>
        <div class="stats-marquee__puce"></div>
        <div class="stats-marquee__item flex items-center gap-4 shrink-0">
          <div class="stat-number !text-white !text-[60px] md:!text-[80px] font-soft font-bold">120<span class="text-vert-light text-[0.7em]">+</span></div>
          <div class="font-bold text-[14px] md:text-[16px] uppercase tracking-wide text-neutral-300">fruits exotiques</div>
        </div>
        <div class="stats-marquee__puce"></div>
        <div class="stats-marquee__item flex items-center gap-4 shrink-0">
          <div class="stat-number !text-white !text-[60px] md:!text-[80px] font-soft font-bold">19 – 56</div>
          <div class="font-bold text-[14px] md:text-[16px] uppercase tracking-wide text-neutral-300">ans, notre équipe</div>
        </div>
        <div class="stats-marquee__puce"></div>
      </div>
    </div>
  </section>

  <style>
    .stats-marquee {
      mask-image: linear-gradient(
        to right,
        transparent 0,
        #000 8%,
        #000 92%,
        transparent 100%
      );
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0,
        #000 8%,
        #000 92%,
        transparent 100%
      );
    }

    .stats-marquee__track {
      animation: stats-marquee-scroll 25s linear infinite;
    }

    .stats-marquee:hover .stats-marquee__track {
      animation-play-state: paused;
    }

    .stats-marquee__puce {
      width: 10px;
      height: 10px;
      border-radius: 999px;
      background-color: #1C6B35;
      flex-shrink: 0;
    }

    @keyframes stats-marquee-scroll {
      from { transform: translate3d(0, 0, 0); }
      to { transform: translate3d(-50%, 0, 0); }
    }

    @media (prefers-reduced-motion: reduce) {
      .stats-marquee__track {
        animation: none;
        transform: none;
        overflow-x: auto;
      }
    }
  </style>

  <!-- REJOINDRE L'ÉQUIPE -->
  <section class="section-sm bg-white">
    <div class="container-mo">
      <div class="grid lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-8">
          <span class="eyebrow">Rejoindre l'équipe</span>
          <h2 class="display-md mt-4 text-balance">
            15 postes ouverts en 2026 <span class="text-vert">— pas de CV requis.</span>
          </h2>
          <p class="mt-5 text-[15.5px] text-neutral-700 leading-relaxed max-w-2xl">
            Boucher·e halal, conseiller·e rayon, chauffeur-livreur, responsable de rayon.
            12 postes en <strong>CDI direct</strong>, formation interne accompagnée,
            grille salariale transparente, tickets restaurant et mutuelle prise en
            charge à 80 %.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="/recrutement" class="btn btn-primary">Voir les offres ouvertes</a>
            <a href="/actualites/recrutement-2026-15-postes" class="btn btn-secondary">
              Lire les détails des 15 postes
            </a>
          </div>
        </div>
        <div class="lg:col-span-4 hidden lg:block">
          <div class="aspect-square rounded-[32px] overflow-hidden shadow-card bg-noir-softer reveal reveal-mask">
            <img
              src="/images/rayons/saveur-mediterranee/ouvrier-d-x27-epicerie.jpg"
              alt="Employé d'épicerie Marché de Mo'"
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MAGASINS teaser -->
  <section class="section bg-blanc">
    <div class="container-mo">
      <div class="text-center max-w-2xl mx-auto">
        <span class="eyebrow">Notre magasin</span>
        <h2 class="display-md mt-4">Venez nous rencontrer.</h2>
      </div>
      <div class="mt-10 max-w-xl mx-auto">
        {Object.values(MAGASINS).map((m) => (
          <a href={`/magasins/${m.slug}`} class="group block bg-white rounded-3xl p-6 md:p-8 border border-black/5 hover:border-vert/20 shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-1 text-center flex flex-col items-center">
            <span class="pill pill-vert">{m.badge}</span>
            <h3 class="font-soft font-bold text-[24px] mt-4">{m.nomCourt}</h3>
            <p class="text-[14px] text-neutral-600 mt-2">{m.adresseLigne1}, {m.codePostal} {m.ville}</p>
            <span class="mt-5 inline-flex items-center gap-2 font-bold text-[14px] text-vert group-hover:translate-x-1 transition-transform">Voir le magasin →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <FAQAccordion items={FAQ_HOME} />
</Layout>
