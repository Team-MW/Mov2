---
import Layout from "@layouts/Layout.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import FAQAccordion from "@components/FAQAccordion.astro";
import ApplicationForm from "@components/islands/ApplicationForm.jsx";
import { getCollection } from "astro:content";
import { SITE } from "@/lib/site";
import { FAQ_RECRUTEMENT } from "@/lib/faqs";
import { breadcrumbSchema } from "@/lib/schema";

const postes = (await getCollection("postes", (p) => p.data.actif))
  .sort((a, b) =>
    new Date(b.data.date_publication).getTime() - new Date(a.data.date_publication).getTime()
  );

const bc = breadcrumbSchema([{ name: "Recrutement", url: "/recrutement" }]);
---

<Layout
  title={`Rejoindre l'équipe — ${postes.length} postes ouverts · ${SITE.name}`}
  description="Nous recrutons toute l'année. Boucherie halal, employé polyvalent, alternance B2B, apprentissage. 90% de notre équipe n'avait pas d'emploi avant le Marché de Mo'."
  faqItems={FAQ_RECRUTEMENT}
  schema={bc}
>
  <Breadcrumb items={[{ name: "Recrutement" }]} />

  <!-- Hero -->
  <section class="bg-noir-section text-white pb-14 relative overflow-hidden">
    <img src="/logos/favicon-marchedemo-contourwh.png" alt="" aria-hidden="true" class="absolute -right-20 top-0 w-[600px] opacity-[0.06] pointer-events-none select-none" />
    <div class="container-mo relative z-10 py-14">
      <span class="eyebrow !text-vert-light">Rejoignez-nous</span>
      <h1 class="display-xl mt-4 text-balance max-w-4xl !text-white" data-split-reveal>
        Pas de diplôme ?<br/>
        Pas d'expérience ?<br/>
        <span class="text-vert-light">Ce n'est pas un problème</span>
      </h1>
      <p class="mt-6 max-w-2xl text-[17px] text-white/80 leading-relaxed">
        <strong class="text-white">90% de notre équipe</strong> n'avait pas d'emploi avant de
        rejoindre le Marché de Mo'. Nous recrutons <strong class="text-white">entre 19 et 56 ans</strong>,
        sur la motivation et le sens du service. Le reste, on vous l'apprend.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row gap-4 items-start sm:items-center">
        <a href="https://fr.linkedin.com/company/march%C3%A9-de-mo" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 bg-white/10 hover:bg-white/20 backdrop-blur-md rounded-2xl p-2 pr-5 transition-all border border-white/10 shadow-xl">
           <div class="w-11 h-11 rounded-[10px] bg-white flex items-center justify-center p-1.5 shrink-0 overflow-hidden">
             <img src="/images/linkedin_logo.png" alt="LinkedIn" class="w-full h-full object-contain" />
           </div>
           <div class="flex flex-col">
             <span class="text-[13px] text-white/70 font-medium leading-tight">Suivez nos actualités sur</span>
             <span class="font-bold text-white leading-tight group-hover:text-vert-light transition-colors mt-0.5">LinkedIn</span>
           </div>
           <svg class="w-4 h-4 text-white/50 group-hover:text-vert-light transition-colors ml-2 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Liste postes -->
  <section class="section bg-blanc">
    <div class="container-mo">
      <span class="eyebrow">Offres ouvertes</span>
      <h2 class="display-md mt-4 text-balance max-w-2xl">
        {postes.length} postes ouverts — <span class="text-vert">et ça continue</span>
      </h2>

      <ul class="mt-10 divide-y divide-black/10">
        {postes.map((p) => (
          <li>
            <a
              href={`/recrutement/${p.slug}`}
              class="group py-6 md:py-7 flex flex-col md:flex-row md:items-center gap-4 md:gap-6 hover:bg-white -mx-4 md:-mx-6 px-4 md:px-6 rounded-2xl transition-colors"
            >
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap mb-2">
                  <span class="pill pill-vert">{p.data.type_contrat}</span>
                  <span class="pill bg-white border border-black/10 text-neutral-600">{p.data.temps}</span>
                  <span class="pill bg-white border border-black/10 text-neutral-600">
                    {p.data.magasin === "toulouse-sud" ? "Toulouse Sud" : "Toulouse Sud"}
                  </span>
                </div>
                <h3 class="font-soft font-bold text-[22px] md:text-[26px] leading-tight">
                  {p.data.titre}
                </h3>
                <p class="mt-1.5 text-[14.5px] text-neutral-600 max-w-2xl">{p.data.resume}</p>
              </div>
              <span class="shrink-0 inline-flex items-center gap-2 font-bold text-[14px] text-vert group-hover:translate-x-1 transition-transform">
                Voir le poste
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- LinkedIn Banner -->
  <section class="section-sm bg-neutral-100/50">
    <div class="container-mo">
      <div class="bg-white rounded-[2rem] p-8 md:p-12 border border-black/5 shadow-sm flex flex-col md:flex-row items-center gap-8 md:gap-12 relative overflow-hidden group">
        <div class="absolute -right-20 -top-20 opacity-[0.03] group-hover:opacity-[0.05] transition-opacity pointer-events-none select-none">
           <img src="/images/linkedin_logo.png" alt="" class="w-[400px] h-[400px] object-contain grayscale" />
        </div>
        <div class="w-24 h-24 md:w-32 md:h-32 shrink-0 rounded-[1.5rem] bg-[#0077B5]/10 flex items-center justify-center p-5 shadow-inner">
          <img src="/images/linkedin_logo.png" alt="LinkedIn Marché de Mo'" class="w-full h-full object-contain group-hover:scale-110 transition-transform duration-500" />
        </div>
        <div class="flex-1 text-center md:text-left relative z-10">
          <h2 class="display-sm text-balance">Retrouvez-nous aussi sur <span class="text-[#0077B5]">LinkedIn</span></h2>
          <p class="mt-4 text-[16px] text-neutral-600 max-w-xl mx-auto md:mx-0 leading-relaxed">
            Plongez dans les coulisses du Marché de Mo', suivez nos actualités RH, découvrez nos métiers et soyez les premiers informés de nos nouvelles ouvertures de postes.
          </p>
          <div class="mt-8 flex justify-center md:justify-start">
            <a href="https://fr.linkedin.com/company/march%C3%A9-de-mo" target="_blank" rel="noopener noreferrer" class="btn btn-primary bg-[#0077B5] hover:bg-[#0077B5]/90 border-transparent text-white shadow-lg shadow-[#0077B5]/20 flex items-center gap-2">
              <span>S'abonner à notre page</span>
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Spontanée -->
  <section class="section bg-white">
    <div class="container-mo grid lg:grid-cols-12 gap-10">
      <div class="lg:col-span-5">
        <span class="eyebrow">Candidature spontanée</span>
        <h2 class="display-md mt-4 text-balance">Aucune offre ne vous correspond ?</h2>
        <p class="mt-5 text-[15.5px] text-neutral-700 leading-relaxed">
          Aucun souci — nous recrutons en permanence. Envoyez-nous votre candidature
          spontanée, nous la regarderons avec attention et reviendrons vers vous
          sous 48h ouvrées.
        </p>
        <div class="mt-8 bg-white rounded-2xl p-5 border-l-4 border-vert">
          <p class="text-[14px] text-neutral-700">
            <strong>Vous préférez le contact direct ?</strong><br/>
            Passez nous voir à Toulouse Sud Cépière tous les mercredis après-midi, sans rendez-vous.
          </p>
        </div>
      </div>
      <div class="lg:col-span-7">
        <ApplicationForm client:visible poste="spontanee" posteNom="Candidature spontanée" />
      </div>
    </div>
  </section>

  <FAQAccordion items={FAQ_RECRUTEMENT} />
</Layout>
