                      </div>
                      <p class="px-2 py-1.5 text-[11px] font-pro font-medium text-neutral-700 line-clamp-2 leading-tight min-h-[34px]">
                        {p.nom}
                      </p>
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- VIDEOS : uniquement sur level 1 pour ne pas alourdir -->
  {level === 1 && videos.length > 0 && (
    <>
      {videoCulture && <div class="culture-divider" data-culture={videoCulture} />}
      <section class="section bg-white" data-culture={videoCulture}>
        <div class="container-mo">
          <span class="eyebrow reveal">En vidéo</span>
          <h2 class="display-md mt-4 max-w-2xl text-balance reveal" data-watermark={videoCultureLabel}>Découvrez le rayon en images.</h2>

