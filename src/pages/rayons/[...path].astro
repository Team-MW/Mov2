                  class="rayon-slide"
                  fetchpriority={i === 0 ? "high" : undefined}
                  loading={i === 0 ? undefined : "lazy"}
                  width="800"
                  height="1000"
                  decoding="async"
                />
              ))}
            </div>
          ) : (
            <img
              src={rayon.image}
              alt={rayon.imageAlt}
              data-parallax="0.25"
              transition:name={`rayon-card-${rayonSlug}`}
