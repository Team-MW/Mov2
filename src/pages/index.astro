---
export const prerender = false;

import Layout from "@layouts/Layout.astro";
import RayonCard from "@components/RayonCard.astro";
import PromoCard from "@components/PromoCard.astro";
import ProduitCard from "@components/ProduitCard.astro";
import RecetteCard from "@components/RecetteCard.astro";
import FAQAccordion from "@components/FAQAccordion.astro";
import FeedbackPopup from "@components/FeedbackPopup.astro";
import LocalVideoPlayer from "@components/islands/LocalVideoPlayer.jsx";
import PromoCarousel from "@components/PromoCarousel.astro";
import PromoHero, { type ExtraSlide } from "@components/PromoHero.astro";
import ActuCarousel from "@components/ActuCarousel.astro";
import PoissonneriePromo from "@components/PoissonneriePromo.astro";
import { getActus } from "@/lib/actus";
import { getCollection } from "astro:content";
import { RAYONS_LIST, ENGAGEMENTS, MAGASINS, SITE } from "@/lib/site";
import { getRecettesVedettes } from "@/lib/recettes";
import { FAQ_HOME } from "@/lib/faqs";
import { organizationSchema, websiteSchema, allMagasinsSchema, offerSchema } from "@/lib/schema";
import { getActivePromos } from "@/lib/promos-repo";
import { getProduitsVedettes } from "@/lib/produits-repo";
import { getHomeEditorialSlides, getHomeSeoSettings } from "@/lib/home-content";

/* Promos : Supabase-first (actif=true), fallback Content Collection.
   featuredPromo (red ticker under PromoHero) is selected from the
   admin: a promo with `ticker_semaine = true` wins, falling back to
   the first `mise_en_avant`, then any active promo. The single-slot
   constraint is enforced server-side by the promos API. */
const allPromos = await getActivePromos();
const featuredPromo =
  allPromos.find((p) => p.data.ticker_semaine) ??
  allPromos.find((p) => p.data.mise_en_avant) ??
  allPromos[0];
const promosHome = allPromos.slice(0, 6);
const promosHero = allPromos.filter((p) => p.data.mise_en_avant).slice(0, 4);

/* Editorial slides for PromoHero — non-promo narratives (app, fidelity,
 * new store, etc). Now editable in the admin via /admin/contenu-home,
 * stored in `public.home_editorial_slides`. The repo function falls
 * back to the previous hardcoded list when Supabase is unreachable, so
 * preview deploys / Supabase outages still render the home page. */
const heroEditorialSlides: ExtraSlide[] = await getHomeEditorialSlides();

/* SEO Settings (Title, description, social OG Image) dynamically loaded from DB settings. */
const seoSettings = await getHomeSeoSettings();

/* Produits vedettes : Supabase-first (ordre asc), fallback static list. */
const PRODUITS_VEDETTES = await getProduitsVedettes(8);

/* Actus du marché — stream unifié (articles + recettes + arrivages +
   nouveautés + événements), pattern Grand Frais. Agrégé via lib/actus.ts,
   affiché en carousel horizontal. */
const actus = await getActus(12);

/* Recettes vedettes : celles avec mise_en_avant=true dans la Collection,
   3-6 max pour la section "Cuisinez le monde" en bas de page. */
const recettesHome = await getRecettesVedettes(3);

/* Videos home */
const videos = (await getCollection("videos", (v) => v.data.actif && v.data.rayon === "home"))
  .sort((a, b) => a.data.ordre - b.data.ordre);

const schemas = [
  organizationSchema(),
  websiteSchema(),
  ...allMagasinsSchema(),
  ...(featuredPromo ? [offerSchema(featuredPromo.data)] : []),
];
---

<Layout
  title={seoSettings.title}
  description={seoSettings.description}
  ogImage={seoSettings.ogImage}
  faqItems={FAQ_HOME}
  schema={schemas}
  heroImage="/images/rayons/epices-du-monde/marche-aux-epices-dubai.jpg"
>
  {/* Big Logo signature area (Moved from header for better scrolling UX) */}
  <div class="w-full flex flex-col items-center justify-center overflow-hidden border-b border-black/5 bg-white py-1">
    <img src="/logos/bacgroundS1ZH.jpeg" alt="Marché de Mo" class="w-full max-w-[700px] object-contain" />
  </div>

  {/* ====================== 1 · PROMO HERO (banner carousel full-width) ====================== */}
  {/* Full-width hero-style carousel : featured promos + editorial slides.
      One slide visible at a time with auto-advance, drag, dots. */}
  <PromoHero
    promos={promosHero}
    extraSlides={heroEditorialSlides}
    autoAdvanceMs={2800}
  />

  {/* ====================== 2 · TICKER PROMO (urgency strip) ====================== */}
  {featuredPromo && (
    <section class="relative overflow-hidden bg-rouge text-white animate-fade-up">
      <div class="container-mo py-4 md:py-5 flex flex-wrap items-center gap-x-6 gap-y-2 text-[13px] md:text-[14px] font-pro">
        <span class="inline-flex items-center gap-2 font-bold">
          <span class="badge-promo !bg-white !text-rouge !shadow-none !min-w-0 !h-auto !px-2 !py-0.5 !text-[12px]">
            -{featuredPromo.data.reduction_pct}%
          </span>
          Offre de la semaine
        </span>
        <span>
          <strong>{featuredPromo.data.titre}</strong> ·
          {featuredPromo.data.prix_promo} € au lieu de {featuredPromo.data.prix_original} €
        </span>
        <a href="/promos" class="ml-auto font-bold underline underline-offset-4 hover:opacity-80 transition">
          Voir toutes les promos →
        </a>
      </div>
    </section>
  )}

  {/* ====================== PROMOS DE LA SEMAINE — IMPULSE BUY ====================== */}
  {promosHome.length > 0 && (
    <section class="section bg-white">
      <div class="container-mo">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 reveal">
          <div class="max-w-2xl">
            <span class="eyebrow eyebrow--rouge">Promos de la semaine</span>
            <h2 class="display-lg mt-4 text-balance">
              Les promos de la semaine
            </h2>
            <p class="mt-3 text-[15px] text-neutral-600">
              Mises à jour chaque semaine. Affichées à l'euro près, dans notre magasin.
            </p>
          </div>
          <a href="/promos" class="btn btn-rouge shrink-0">
            Voir toutes les promos
          </a>
        </div>

        <PromoCarousel promos={promosHome} />
      </div>
    </section>
  )}

  {/* ====================== NOS RAYONS ====================== */}
  <section class="section bg-blanc">
    <div class="container-mo">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8 reveal">
        <div class="max-w-2xl">
          <h2 class="display-lg text-vert">Nos rayons</h2>
          <p class="mt-3 text-[16px] text-neutral-600 max-w-xl">
            20 000 références, un seul ticket de caisse.
          </p>
        </div>
        <a href="/rayons" class="btn btn-secondary shrink-0">
          Voir tous les rayons
        </a>
      </div>

      {/* Étiquettes rayons — reprend la charte « Nos Rayons » (blocs de couleur inclinés) */}
      <ul class="rayon-tags mb-12" aria-label="Accès rapide aux rayons">
        {RAYONS_LIST.map((r, i) => (
          <li>
            <a
              href={`/rayons/${r.slug}`}
              class="rayon-tag"
              style={`--tag-bg: ${r.accent ?? "#1C6B35"}; --tag-ink: ${r.accentInk ?? "#FFFFFF"}; --tag-rot: ${[-1.6, 1.2, -0.6, 1.8, -1.2, 0.8, -1.8, 1.4][i % 8]}deg;`}
            >
              {r.nom}
            </a>
          </li>
        ))}
      </ul>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
        {/* 5 cartes = 2 lignes pleines (la 1re occupe 2 colonnes). Tous les
            rayons restent accessibles via les étiquettes au-dessus. */}
        {RAYONS_LIST.slice(0, 5).map((r, i) => (
          <RayonCard rayon={r} large={i === 0} />
        ))}
      </div>
    </div>
  </section>

  {/* ====================== POISSONNERIE — mise en avant du nouveau rayon ====================== */}
  <PoissonneriePromo />

  {/* ====================== VIDEOS TIKTOK — social proof ====================== */}
  {videos.length > 0 && (
    <section class="section bg-blanc animate-fade-up">
      <div class="container-mo">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 reveal">
          <div class="max-w-2xl">
            <span class="eyebrow">Marché de Mo' en vidéos</span>
            <h2 class="display-lg mt-4 text-balance">
              Rencontrez nos équipes et nos rayons
            </h2>
          </div>
          <a href="https://www.tiktok.com/@marchedemo" target="_blank" rel="noopener noreferrer" class="btn btn-secondary shrink-0">
            Nous suivre sur TikTok
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {videos.slice(0, 3).map((v) => {
            return (
              <LocalVideoPlayer
                client:visible
                src={v.data.src_local}
                title={v.data.titre}
                href={v.data.url_tiktok}
              />
            );
          })}
        </div>
      </div>
    </section>
  )}

  {/* ====================== AUSSI DANS VOTRE MAGASIN — Picadeli + Too Good To Go ====================== */}
  <section class="section bg-neutral-50 border-y border-black/5">
    <div class="container-mo">
      <div class="max-w-2xl mb-10 reveal">
        <span class="eyebrow">En magasin</span>
        <h2 class="display-lg mt-4 text-balance">Aussi chez Mo'</h2>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <article class="partner-card reveal">
          <div class="partner-card__media bg-neutral-100">
            <img src="/images/partenaires/picadeli-salade.webp" alt="Salade fraîche du bar Picadeli" loading="lazy" class="w-full h-full object-contain p-4" />
          </div>
          <div class="partner-card__body">
            <img src="/images/partenaires/picadeli-logo.png" alt="Picadeli" class="h-10 w-auto self-start object-contain object-left mix-blend-multiply" />
            <h3 class="mt-4 text-[clamp(1.6rem,2.6vw,2.1rem)] leading-[1.04]">Le bar à salade Picadeli</h3>
            <p class="mt-3 text-[16px] text-neutral-600 leading-relaxed">
              Composez votre salade sur-mesure avec des dizaines d'ingrédients frais, préparés chaque jour dans notre magasin de Toulouse Sud — Cépière.
            </p>
            <div class="mt-6 flex flex-wrap items-center gap-4">
              <a href="/magasins/toulouse-sud" class="btn text-white" style="background:#3E9A46">Venir en magasin</a>
              <a href="https://www.picadeli.fr/fr/nos-produits" target="_blank" rel="noopener noreferrer" class="font-bold text-[15px] underline underline-offset-4" style="color:#3E9A46">Les recettes Picadeli</a>
            </div>
          </div>
        </article>

        <article class="partner-card reveal" style="--reveal-delay: 120ms">
          <div class="partner-card__media bg-white">
            <img src="/images/partenaires/tgtg-banner.png" alt="Paniers anti-gaspi Too Good To Go" loading="lazy" class="w-full h-full object-cover" />
          </div>
          <div class="partner-card__body">
            <img src="/images/partenaires/tgtg-logo.png" alt="Too Good To Go" class="h-14 w-auto self-start object-contain object-left mix-blend-multiply" />
            <h3 class="mt-4 text-[clamp(1.6rem,2.6vw,2.1rem)] leading-[1.04]">Paniers anti-gaspi</h3>
            <p class="mt-3 text-[16px] text-neutral-600 leading-relaxed">
              Avec Too Good To Go, sauvez des paniers surprises composés des invendus du jour, à prix très réduits. Bon pour la planète et pour votre porte-monnaie.
            </p>
            <div class="mt-6">
              <a href="/too-good-to-go" class="btn text-white" style="background:#00645A">Découvrir notre démarche</a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  {/* ====================== WHATSAPP — bandeau compact ====================== */}
  <section class="wa-band">
    <div class="container-mo py-10 md:py-12 grid md:grid-cols-[auto_1fr_auto] items-center gap-6 md:gap-10">
      <img src="/images/whatsapp-logo.avif" alt="" aria-hidden="true" class="w-16 h-16 md:w-20 md:h-20 rounded-2xl object-cover" loading="lazy" />
      <div>
        <h2 class="display-md text-white">Le catalogue en avant-première sur WhatsApp</h2>
        <p class="mt-2 text-[16px] text-white/85 max-w-2xl">
          Arrivages, promos et catalogue de la semaine, directement sur votre téléphone. Gratuit, désabonnement en un clic.
        </p>
      </div>
      <a href="https://whatsapp.com/channel/0029Vb8ix0yI1rcr1BkAll1I" target="_blank" rel="noopener noreferrer" class="btn bg-white hover:bg-[#E9FBEF]" style="color:#128C4A">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.711.927 3.149.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.768-5.77zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-14.416c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm.029 18.88c-1.161 0-2.305-.292-3.318-.844l-3.677.964 1.006-3.585c-.605-1.085-.928-2.34-.928-3.633 0-4.133 3.366-7.499 7.502-7.499 4.134 0 7.499 3.365 7.499 7.499 0 4.133-3.365 7.499-7.499 7.499z"/></svg>
        Rejoindre le canal
      </a>
    </div>
  </section>

  {/* ====================== ACTUS DU MARCHÉ — carousel unifié (pattern Grand Frais) ======================
      Stream agrégé : articles éditoriaux, recettes, arrivages saisonniers,
      nouveautés catalogue, événements magasin. Toutes les cards suivent le
      même format (image + badge rayon + titre) pour cohérence visuelle.
      Auto-scroll lent, swipe, drag, flèches, keyboard — tout accessible. */}
  {actus.length > 0 && (
    <section class="section bg-blanc relative overflow-hidden">
      <div class="container-mo">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 reveal">
          <div class="max-w-2xl">
            <span class="eyebrow">Les actus du marché</span>
            <h2 class="display-lg mt-4 text-balance">
              Ce qui bouge<br/>
              en ce moment
            </h2>
            <p class="mt-3 text-[15px] text-neutral-600">
              Arrivages de saison, nouveautés en rayon, événements, recettes d'inspiration.
              Le pouls du marché, chaque semaine.
            </p>
          </div>
          <a href="/actualites" class="btn btn-secondary shrink-0 btn-sheen">
            Toutes les actus
          </a>
        </div>

        <ActuCarousel actus={actus} />
      </div>
    </section>
  )}

  {/* ====================== QUI EST MO' — émotionnel ====================== */}
  <section class="section bg-noir-section relative overflow-hidden">
    <img
      src="/logos/favicon-marchedemo-contourwh.png"
      alt=""
      aria-hidden="true"
      class="absolute -right-20 top-10 w-[640px] max-w-[80%] opacity-[0.06] pointer-events-none select-none"
    />
    <div class="container-mo relative z-10 grid lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7">
        <span class="eyebrow !text-vert-light">Notre histoire</span>
        <h2 class="display-lg mt-4 text-balance !text-white">
          Mo', c'était<br/>
          Mohamed
        </h2>
        <div class="mt-6 space-y-4 text-white/75 text-[16px] leading-relaxed max-w-2xl">
          <p>
            Le patriarche. Le père d’une famille de commerçants passionnés, à l’origine de l’histoire et des valeurs qui ont donné naissance au Marché de Mo’.
          </p>
          <p>
            Une aventure familiale portée par une conviction simple : rendre les saveurs du monde accessibles à tous, en associant la qualité et la fraîcheur des produits aux prix d’un supermarché.
          </p>
          <p>
            Aujourd’hui, le Marché de Mo’, c’est une équipe de <strong class="text-white">24 salariés</strong> et un engagement fort pour l’emploi local : <strong class="text-white">90 % de nos collaborateurs</strong> étaient sans emploi avant de rejoindre l’aventure.
          </p>
          <p>
            Plus qu’un supermarché, c’est une histoire de transmission, de commerce et de proximité.
          </p>
        </div>
        <div class="mt-10 flex flex-col sm:flex-row gap-3">
          <a href="/notre-enseigne" class="btn btn-primary btn-sheen">Notre enseigne</a>
          <a href="/nos-engagements" class="btn btn-ghost !text-white !border-white/25 hover:!border-white">
            Nos engagements
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="relative aspect-square rounded-full overflow-hidden bg-gradient-to-br from-vert-dark/40 to-black/60 ring-4 ring-white/10 reveal reveal-mask">
          <img
            src="/images/home/fondateur-mo.png"
            alt="Mohamed — le père, patriarche de la famille fondatrice du Marché de Mo'"
            class="absolute inset-0 w-full h-full object-contain object-bottom p-6"
            width="900"
            height="900"
            loading="lazy"
          />
          <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-black/40 to-transparent"></div>
        </div>
      </div>
    </div>
  </section>

  {/* ====================== ENGAGEMENTS — trust ====================== */}
  <section class="section bg-white">
    <div class="container-mo">
      <div class="text-center max-w-3xl mx-auto mb-14 reveal">
        <span class="eyebrow !justify-center">Nos 4 engagements</span>
        <h2 class="display-lg mt-4 text-balance">
          Un supermarché, oui.<br/>
          Un engagement, surtout
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 md:gap-6">
        {ENGAGEMENTS.map((e, i) => (
          <article
            class="bg-white rounded-lg p-8 shadow-card hover:shadow-card-hover transition-all duration-300 reveal"
            style={`--reveal-delay: ${i * 80}ms`}
          >
            <div class="w-14 h-14 rounded-lg bg-vert/10 text-vert flex items-center justify-center mb-6">
              {e.icone === "heart" && (
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                </svg>
              )}
              {e.icone === "people" && (
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                  <circle cx="9" cy="7" r="4"/>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
              )}
              {e.icone === "trophy" && (
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6M18 9h1.5a2.5 2.5 0 0 0 0-5H18M4 22h16M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22M18 2H6v7a6 6 0 0 0 12 0V2z"/>
                </svg>
              )}
              {e.icone === "care" && (
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                  <path d="M12 7v4M9 9h6"/>
                </svg>
              )}
            </div>
            <h3 class="font-soft font-bold text-[20px] leading-tight">{e.titre}</h3>
            <p class="mt-2 text-[14px] text-neutral-500 font-pro">{e.resume}</p>
            <p class="mt-4 text-[14px] text-neutral-700 leading-relaxed">{e.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ====================== PRODUITS VEDETTES — vitrine sans prix ====================== */}
  <section class="section bg-white">
    <div class="container-mo">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 reveal">
        <div class="max-w-2xl">
          <span class="eyebrow">Produits vedettes</span>
          <h2 class="display-lg mt-4 text-balance">
            Du monde entier,<br/>
            dans votre panier
          </h2>
          <p class="mt-3 text-[15px] text-neutral-600">
            Notre sélection du moment, rayon par rayon. Prix affichés à l'euro près en magasin.
          </p>
        </div>
        <a href="/rayons" class="btn btn-secondary shrink-0 btn-sheen">
          Explorer les rayons
        </a>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-5">
        {PRODUITS_VEDETTES.map((p, i) => (
          <div class="reveal" style={`--reveal-delay: ${(i % 4) * 60}ms`}>
            <ProduitCard produit={p} />
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ====================== RECETTES — inspiration use-case ====================== */}
  <section class="section bg-white">
    <div class="container-mo">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 reveal">
        <div class="max-w-2xl">
          <span class="eyebrow">Recettes du monde</span>
          <h2 class="display-lg mt-4 text-balance">
            Cuisinez la planète,<br/>
            avec nos rayons
          </h2>
          <p class="mt-3 text-[15px] text-neutral-600">
            Mafé sénégalais, bibimbap coréen, tajine marocain, phở vietnamien…
            Recettes authentiques, ingrédients en rayon, explications pas à pas.
          </p>
        </div>
        <a href="/recettes" class="btn btn-secondary shrink-0 btn-sheen">
          Toutes les recettes
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
        {recettesHome.map((r, i) => (
          <div class="reveal" style={`--reveal-delay: ${i * 80}ms`}>
            <RecetteCard recette={r} />
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ====================== MAGASIN — infos pratiques ====================== */}
  {(() => {
    const m = Object.values(MAGASINS)[0];
    return (
      <section class="section bg-white">
        <div class="container-mo grid lg:grid-cols-2 gap-10 lg:gap-14 items-stretch">
          <div class="reveal flex flex-col">
            <span class="eyebrow self-start">Notre magasin</span>
            <h2 class="display-lg mt-4 text-balance">{m.nomCourt}</h2>
            <p class="mt-4 text-[17px] text-neutral-600 leading-relaxed max-w-xl">{m.description}</p>

            <dl class="store-facts mt-8">
              <div>
                <dt>Adresse</dt>
                <dd>{m.adresseLigne1}<br />{m.codePostal} {m.ville}</dd>
              </div>
              <div>
                <dt>Horaires</dt>
                <dd>Lundi – samedi : {m.horaires.lundiSamedi}<br />Dimanche : {m.horaires.dimanche}</dd>
              </div>
              <div>
                <dt>Téléphone</dt>
                <dd><a href={`tel:${m.telE164}`} class="underline underline-offset-4 hover:text-vert">{m.telephone}</a></dd>
              </div>
              <div>
                <dt>Sur place</dt>
                <dd>{m.surface} · parking {m.parking}</dd>
              </div>
            </dl>

            <div class="mt-8 flex flex-wrap gap-3">
              <a href={m.mapsLink} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Itinéraire</a>
              <a href={`/magasins/${m.slug}`} class="btn btn-secondary">Voir la page du magasin</a>
            </div>
          </div>

          <div class="reveal rounded-lg overflow-hidden ring-1 ring-black/10 min-h-[320px] bg-neutral-100">
            <iframe
              src={m.mapsEmbed}
              title={`Plan d'accès — ${m.nom}`}
              loading="lazy"
              class="w-full h-full min-h-[320px] border-0"
              referrerpolicy="no-referrer"
            ></iframe>
          </div>
        </div>
      </section>
    );
  })()}

  {/* ====================== FAQ ====================== */}
  <FAQAccordion items={FAQ_HOME} />

  {/* ====================== FEEDBACK POPUP ====================== */}
  <FeedbackPopup />

</Layout>

<script>
  function runPhoneSimulator() {
    const splash = document.getElementById("sim-screen-splash");
    const floatBadge = document.getElementById("sim-float-badge");
    const cartBadge = document.getElementById("sim-cart-badge");
    const mainScroll = document.getElementById("sim-main-scroll");
    const progress = document.getElementById("sim-delivery-progress");
    const status = document.getElementById("sim-delivery-status");
    const addBtn = document.getElementById("sim-add-btn");
    const addBtn2 = document.getElementById("sim-add-btn-2");
    const laser = document.getElementById("sim-barcode-laser");
    const scanOverlay = document.getElementById("sim-scan-overlay");
    const pointsEl = document.getElementById("sim-loyalty-points");
    
    if (!splash || !floatBadge || !cartBadge || !mainScroll || !progress || !status || !laser || !scanOverlay || !pointsEl) return;

    let timer: number;
    let timeouts: number[] = [];

    const clearAllTimeouts = () => {
      timeouts.forEach(t => clearTimeout(t));
      timeouts = [];
    };

    // Dynamic category product catalog mapping to make simulator lively
    const categoryProducts = [
      {
        p1: { title: "Mangue José", desc: "Île de la Réunion", price: "3,90€", img: "/images/promos/mangue.jpg" },
        p2: { title: "Banane Plantain", desc: "Arrivage Côte d'Ivoire", price: "1,99€", img: "/images/rayons/fruits-legumes.jpg" }
      },
      {
        p1: { title: "Épaule d'Agneau", desc: "Halal, découpe du jour", price: "12,90€", img: "/images/rayons/boucherie-halal.jpg" },
        p2: { title: "Bifteck de Bœuf", desc: "Halal, origine France", price: "14,90€", img: "/images/rayons/boucherie-halal/11062b-603fa6aa568c43e08182a6e546211812f000.jpg" }
      },
      {
        p1: { title: "Ras el Hanout", desc: "Mélange maison premium", price: "4,50€", img: "/images/rayons/epices-du-monde.jpg" },
        p2: { title: "Safran Pur Pistils", desc: "Import direct d'Iran", price: "8,90€", img: "/images/rayons/epices-du-monde/marche-aux-epices-dubai.jpg" }
      },
      {
        p1: { title: "Sauce Soja Kikkoman", desc: "Bouteille en verre 150ml", price: "2,80€", img: "/images/rayons/saveurs-asie.jpg" },
        p2: { title: "Nouilles Udon", desc: "Nouilles fraîches 200g", price: "1,50€", img: "/images/rayons/saveurs-asie/image-de-jason-leung.jpg" }
      }
    ];

    const setCategoryActive = (idx: number) => {
      for (let i = 0; i < 4; i++) {
        const cat = document.getElementById(`sim-cat-${i}`);
        if (!cat) continue;
        if (i === idx) {
          cat.classList.remove("bg-white/5", "border-white/5");
          cat.classList.add("bg-white/15", "border-vert/30", "scale-[1.03]");
        } else {
          cat.classList.remove("bg-white/15", "border-vert/30", "scale-[1.03]");
          cat.classList.add("bg-white/5", "border-white/5");
        }
      }

      // Update product cards dynamic images and text for realistic simulator feel
      const prodData = categoryProducts[idx];
      if (prodData) {
        const p1Img = document.getElementById("sim-p1-img") as HTMLImageElement | null;
        const p1Title = document.getElementById("sim-p1-title");
        const p1Desc = document.getElementById("sim-p1-desc");
        const p1Price = document.getElementById("sim-p1-price");
        const p2Img = document.getElementById("sim-p2-img") as HTMLImageElement | null;
        const p2Title = document.getElementById("sim-p2-title");
        const p2Desc = document.getElementById("sim-p2-desc");
        const p2Price = document.getElementById("sim-p2-price");

        if (p1Img) p1Img.src = prodData.p1.img;
        if (p1Title) p1Title.textContent = prodData.p1.title;
        if (p1Desc) p1Desc.textContent = prodData.p1.desc;
        if (p1Price) p1Price.textContent = prodData.p1.price;

        if (p2Img) p2Img.src = prodData.p2.img;
        if (p2Title) p2Title.textContent = prodData.p2.title;
        if (p2Desc) p2Desc.textContent = prodData.p2.desc;
        if (p2Price) p2Price.textContent = prodData.p2.price;
      }
    };

    const startLoop = () => {
      clearAllTimeouts();

      // Step 1: Reset to initial state
      splash.style.opacity = "1";
      splash.style.pointerEvents = "auto";
      floatBadge.classList.remove("scale-100");
      floatBadge.classList.add("scale-0");
      cartBadge.textContent = "0";
      cartBadge.classList.remove("scale-100");
      cartBadge.classList.add("scale-0");
      if (addBtn) addBtn.textContent = "Ajouter";
      if (addBtn2) {
        addBtn2.textContent = "Ajouter";
        addBtn2.classList.remove("bg-vert");
        addBtn2.classList.add("bg-white/10", "text-white");
      }
      mainScroll.scrollTo({ top: 0, behavior: "auto" });
      progress.style.transition = "none";
      progress.style.width = "25%";
      status.textContent = "Préparation de votre colis...";
      
      laser.style.transition = "none";
      laser.style.top = "0";
      laser.style.opacity = "0";
      scanOverlay.style.opacity = "0";
      pointsEl.innerHTML = `150 <span class="text-[8px] font-medium text-white/60">points</span>`;

      setCategoryActive(0);

      // Timeout helper
      const delay = (fn: () => void, ms: number) => {
        timeouts.push(setTimeout(fn, ms) as any);
      };

      // Step 2: Hide Splash screen after 1.2s
      delay(() => {
        splash.style.opacity = "0";
        splash.style.pointerEvents = "none";
      }, 1200);

      // Step 3: Laser scan loyalty barcode
      delay(() => {
        laser.style.transition = "top 1s linear, opacity 0.2s ease";
        laser.style.opacity = "1";
        laser.style.top = "100%";
      }, 2000);

      // Step 4: Show scan success overlay
      delay(() => {
        laser.style.opacity = "0";
        scanOverlay.style.opacity = "1";
      }, 3000);

      // Step 5: Increment points from 150 to 180
      delay(() => {
        let pts = 150;
        const interval = setInterval(() => {
          pts++;
          pointsEl.innerHTML = `${pts} <span class="text-[8px] font-medium text-white/60">points</span>`;
          if (pts >= 180) clearInterval(interval);
        }, 25);
        
        // Pulse points text
        pointsEl.classList.add("scale-110");
        setTimeout(() => {
          pointsEl.classList.remove("scale-110");
        }, 1000);
      }, 3300);

      // Step 6: Hide scan overlay
      delay(() => {
        scanOverlay.style.opacity = "0";
      }, 4800);

      // Step 7: Tap category "Viandes" (idx 1)
      delay(() => {
        setCategoryActive(1);
      }, 5500);

      // Step 8: Scroll to Products Section
      delay(() => {
        mainScroll.scrollTo({ top: 120, behavior: "smooth" });
      }, 6200);

      // Step 9: Click 'Ajouter' and update cart to 1
      delay(() => {
        if (addBtn) addBtn.textContent = "Ajouté !";
        cartBadge.textContent = "1";
        cartBadge.classList.remove("scale-0");
        cartBadge.classList.add("scale-100");
        
        // Pop effect
        cartBadge.classList.add("scale-125");
        setTimeout(() => cartBadge.classList.remove("scale-125"), 200);

        floatBadge.classList.remove("scale-0");
        floatBadge.classList.add("scale-100");
      }, 7500);

      // Step 10: Hide floating badge
      delay(() => {
        floatBadge.classList.remove("scale-100");
        floatBadge.classList.add("scale-0");
      }, 8800);

      // Step 11: Tap category "Épices" (idx 2)
      delay(() => {
        setCategoryActive(2);
      }, 9500);

      // Step 12: Add second item (click Product 2 button in Viandes category - which is actually Épices now)
      delay(() => {
        cartBadge.textContent = "2";
        cartBadge.classList.add("scale-125");
        setTimeout(() => cartBadge.classList.remove("scale-125"), 200);

        if (addBtn2) {
          addBtn2.textContent = "Ajouté !";
          addBtn2.classList.remove("bg-white/10", "text-white");
          addBtn2.classList.add("bg-vert", "text-white");
        }

        // Update float text to show second item added
        const floatTextEl = floatBadge.querySelector("span");
        if (floatTextEl) floatTextEl.textContent = "2e produit ajouté !";

        floatBadge.classList.remove("scale-0");
        floatBadge.classList.add("scale-100");
      }, 10800);

      // Step 13: Hide floating badge and restore text
      delay(() => {
        floatBadge.classList.remove("scale-100");
        floatBadge.classList.add("scale-0");
        delay(() => {
          const floatTextEl = floatBadge.querySelector("span");
          if (floatTextEl) floatTextEl.textContent = "Produit ajouté !";
        }, 400);
      }, 12000);

      // Step 14: Scroll to tracking
      delay(() => {
        mainScroll.scrollTo({ top: 300, behavior: "smooth" });
      }, 12800);

      // Step 15: Animate delivery progress
      delay(() => {
        progress.style.transition = "width 2s cubic-bezier(0.4, 0, 0.2, 1)";
        progress.style.width = "100%";
        status.textContent = "Colis livré ! À bientôt.";
      }, 14200);

      // Step 16: Loop back
      timer = setTimeout(startLoop, 18000) as any;
    };

    startLoop();
  }

  // Run on page load
  runPhoneSimulator();
  document.addEventListener("astro:page-load", runPhoneSimulator);
</script>

