<script>
  function runPhoneSimulator() {
    const splash = document.getElementById("sim-screen-splash");
    const floatBadge = document.getElementById("sim-float-badge");
    const cartBadge = document.getElementById("sim-cart-badge");
    const mainScroll = document.getElementById("sim-main-scroll");
    const progress = document.getElementById("sim-delivery-progress");
    const status = document.getElementById("sim-delivery-status");
    const addBtn = document.getElementById("sim-add-btn");
    const laser = document.getElementById("sim-barcode-laser");
    const scanOverlay = document.getElementById("sim-scan-overlay");
    const pointsEl = document.getElementById("sim-loyalty-points");
    
    if (!splash || !floatBadge || !cartBadge || !mainScroll || !progress || !status || !laser || !scanOverlay || !pointsEl) return;

    let timer: number;
    let timeouts: number[] = [];

    const clearAllTimeouts = () => {
      timeouts.forEach(t => clearTimeout(t));
      timeouts = [];
    };

    const setCategoryActive = (idx: number) => {
      for (let i = 0; i < 4; i++) {
        const cat = document.getElementById(`sim-cat-${i}`);
        if (!cat) continue;
        if (i === idx) {
          cat.classList.remove("bg-white/5", "border-white/5");
          cat.classList.add("bg-white/15", "border-vert/30", "scale-[1.03]");
        } else {
          cat.classList.remove("bg-white/15", "border-vert/30", "scale-[1.03]");
          cat.classList.add("bg-white/5", "border-white/5");
        }
      }
    };

    const startLoop = () => {
      clearAllTimeouts();

      // Step 1: Reset to initial state
      splash.style.opacity = "1";
      splash.style.pointerEvents = "auto";
      floatBadge.classList.remove("scale-100");
      floatBadge.classList.add("scale-0");
      cartBadge.textContent = "0";
      cartBadge.classList.remove("scale-100");
      cartBadge.classList.add("scale-0");
      if (addBtn) addBtn.textContent = "Ajouter";
      mainScroll.scrollTo({ top: 0, behavior: "auto" });
      progress.style.transition = "none";
      progress.style.width = "25%";
      status.textContent = "Préparation de votre colis...";
      
      laser.style.transition = "none";
      laser.style.top = "0";
      laser.style.opacity = "0";
      scanOverlay.style.opacity = "0";
      pointsEl.innerHTML = `150 <span class="text-[8px] font-medium text-white/60">points</span>`;

      setCategoryActive(0);

      // Timeout helper
      const delay = (fn: () => void, ms: number) => {
        timeouts.push(setTimeout(fn, ms) as any);
      };

      // Step 2: Hide Splash screen after 1.2s
      delay(() => {
        splash.style.opacity = "0";
        splash.style.pointerEvents = "none";
      }, 1200);

      // Step 3: Laser scan loyalty barcode
      delay(() => {
        laser.style.transition = "top 1s linear, opacity 0.2s ease";
        laser.style.opacity = "1";
        laser.style.top = "100%";
      }, 2000);

      // Step 4: Show scan success overlay
      delay(() => {
        laser.style.opacity = "0";
        scanOverlay.style.opacity = "1";
      }, 3000);

      // Step 5: Increment points from 150 to 180
      delay(() => {
        let pts = 150;
        const interval = setInterval(() => {
          pts++;
          pointsEl.innerHTML = `${pts} <span class="text-[8px] font-medium text-white/60">points</span>`;
          if (pts >= 180) clearInterval(interval);
        }, 25);
        
        // Pulse points text
        pointsEl.classList.add("scale-110");
        setTimeout(() => {
          pointsEl.classList.remove("scale-110");
        }, 1000);
      }, 3300);

      // Step 6: Hide scan overlay
      delay(() => {
        scanOverlay.style.opacity = "0";
      }, 4800);

      // Step 7: Tap category "Viandes" (idx 1)
      delay(() => {
        setCategoryActive(1);
      }, 5500);

      // Step 8: Scroll to Products Section
      delay(() => {
        mainScroll.scrollTo({ top: 120, behavior: "smooth" });
      }, 6200);

      // Step 9: Click 'Ajouter' and update cart to 1
      delay(() => {
        if (addBtn) addBtn.textContent = "Ajouté !";
        cartBadge.textContent = "1";
        cartBadge.classList.remove("scale-0");
        cartBadge.classList.add("scale-100");
        
        // Pop effect
        cartBadge.classList.add("scale-125");
        setTimeout(() => cartBadge.classList.remove("scale-125"), 200);

        floatBadge.classList.remove("scale-0");
        floatBadge.classList.add("scale-100");
      }, 7500);

      // Step 10: Hide floating badge
      delay(() => {
        floatBadge.classList.remove("scale-100");
        floatBadge.classList.add("scale-0");
      }, 8800);

      // Step 11: Tap category "Épices" (idx 2)
      delay(() => {
        setCategoryActive(2);
      }, 9500);

      // Step 12: Add second item
      delay(() => {
        cartBadge.textContent = "2";
        cartBadge.classList.add("scale-125");
        setTimeout(() => cartBadge.classList.remove("scale-125"), 200);

        // Update float text to show second item added
        const floatTextEl = floatBadge.querySelector("span");
        if (floatTextEl) floatTextEl.textContent = "2e produit ajouté !";

        floatBadge.classList.remove("scale-0");
        floatBadge.classList.add("scale-100");
      }, 10800);

      // Step 13: Hide floating badge and restore text
      delay(() => {
        floatBadge.classList.remove("scale-100");
        floatBadge.classList.add("scale-0");
        delay(() => {
          const floatTextEl = floatBadge.querySelector("span");
          if (floatTextEl) floatTextEl.textContent = "Produit ajouté !";
        }, 400);
      }, 12000);

      // Step 14: Scroll to tracking
      delay(() => {
        mainScroll.scrollTo({ top: 300, behavior: "smooth" });
      }, 12800);

      // Step 15: Animate delivery progress
      delay(() => {
        progress.style.transition = "width 2s cubic-bezier(0.4, 0, 0.2, 1)";
        progress.style.width = "100%";
        status.textContent = "Colis livré ! À bientôt.";
      }, 14200);

      // Step 16: Loop back
      timer = setTimeout(startLoop, 18000) as any;
    };

    startLoop();
  }

  // Run on page load
  runPhoneSimulator();
  document.addEventListener("astro:page-load", runPhoneSimulator);
</script>



