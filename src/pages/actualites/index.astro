---
import Layout from "@layouts/Layout.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import { getCollection } from "astro:content";
import { SITE } from "@/lib/site";
import { breadcrumbSchema } from "@/lib/schema";

const articles = (await getCollection("articles", (a) => a.data.actif))
  .sort((a, b) =>
    new Date(b.data.date_publication).getTime() - new Date(a.data.date_publication).getTime()
  );

const featured = articles[0];
const others = articles.slice(1);

const bc = breadcrumbSchema([{ name: "Actualités", url: "/actualites" }]);

/* Couleurs + labels par catégorie — identiques au detail page. */
const CATEGORIE_META: Record<string, { label: string; color: string; bg: string }> = {
  promos: { label: "Promos", color: "#8B1919", bg: "#FCE7E7" },
  nouveautes: { label: "Nouveautés", color: "#1C6B35", bg: "#E5F3EB" },
  recettes: { label: "Recettes", color: "#A68332", bg: "#FAF4E4" },
  engagements: { label: "Engagements", color: "#2563EB", bg: "#E3EBFB" },
  evenements: { label: "Événements", color: "#7D4500", bg: "#F5E9D4" },
};
const getMeta = (cat: string) =>
  CATEGORIE_META[cat] ?? { label: cat, color: "#1C6B35", bg: "#E5F3EB" };
---

<Layout
  title={`Actualités & événements · ${SITE.name}`}
  description="Les actualités du Marché de Mo' — ouvertures, partenariats, engagements, événements. Suivez la vie de notre magasin toulousain."
  schema={bc}
>
  <Breadcrumb items={[{ name: "Actualités" }]} />

  <!-- Hero -->
  <section class="bg-blanc pb-8">
    <div class="container-mo">
      <span class="eyebrow">Actualités</span>
      <h1 class="display-xl mt-4 text-balance max-w-4xl" data-split-reveal>
        La vie du <span class="text-vert">Marché de Mo'</span>.
      </h1>
      <p class="mt-6 max-w-2xl text-[17px] text-neutral-600 leading-relaxed">
        Nos ouvertures, nos partenariats, nos événements. Tout ce qui fait l'actualité
        de votre magasin préféré à Toulouse.
      </p>
    </div>
  </section>

  <!-- Featured article replaced by Picadeli -->
  <section class="bg-white pb-12 pt-8">
    <div class="container-mo grid lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-6 reveal">
        <span class="eyebrow">À la une</span>
        <img 
          src="/images/partenaires/picadeli-logo.png" 
          alt="Picadeli Logo" 
          class="h-16 object-contain mb-6 mt-4 mix-blend-multiply" 
        />
        <h2 class="display-xl mt-2 text-balance" data-split-reveal>
          Créez votre propre<br/>
          <span class="text-[#6BC172]">salade sur-mesure</span>.
        </h2>
        <p class="mt-6 max-w-xl text-[17px] text-neutral-600 leading-relaxed">
          Le bar à salade <strong>Picadeli</strong> est désormais disponible dans notre magasin de Toulouse Sud — Cépière. 
          Faites le plein de fraîcheur avec des dizaines d'ingrédients gourmands, sains, et préparés chaque jour.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/magasins/toulouse-sud" class="btn btn-primary bg-[#6BC172] border-[#6BC172] text-white hover:bg-[#5AA161]">Venir en magasin</a>
          <a href="https://www.picadeli.fr/fr/nos-produits" target="_blank" rel="noopener noreferrer" class="btn btn-outline border-[#6BC172] text-[#6BC172] hover:bg-[#6BC172] hover:text-white">Voir les recettes Picadeli</a>
        </div>
      </div>
      <div class="lg:col-span-6 reveal" style="--reveal-delay: 200ms">
        <div class="relative rounded-3xl overflow-hidden shadow-2xl bg-neutral-100 p-4">
          <img 
            src="/images/partenaires/picadeli-salade.webp" 
            alt="Salade fraîche Picadeli" 
            class="w-full h-auto object-cover rounded-2xl" 
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Grid -->
  {others.length > 0 && (
    <section class="section bg-white">
      <div class="container-mo">
        <h2 class="display-md text-balance max-w-2xl">Tous les articles.</h2>
        <div class="mt-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {others.map((a, i) => {
            const meta = getMeta(a.data.categorie);
            return (
              <a
                href={`/actualites/${a.slug}`}
                class="group bg-white rounded-3xl overflow-hidden shadow-card hover:shadow-card-hover hover:-translate-y-0.5 transition-all reveal reveal-scale"
                style={`--reveal-delay: ${(i % 3) * 70}ms`}
              >
                <div class="aspect-[4/3] overflow-hidden bg-white">
                  <img
                    src={a.data.image}
                    alt={a.data.titre}
                    class="w-full h-full object-cover group-hover:scale-[1.06] transition-transform duration-500"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="p-6">
                  <span
                    class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-pro font-bold uppercase tracking-wider"
                    style={`color: ${meta.color}; background: ${meta.bg}`}
                  >
                    <span class="w-1.5 h-1.5 rounded-full" style={`background: ${meta.color}`}></span>
                    {meta.label}
                  </span>
                  <h3 class="font-soft font-bold text-[19px] leading-tight mt-3 group-hover:text-vert transition-colors">
                    {a.data.titre}
                  </h3>
                  <p class="mt-2 text-[13.5px] text-neutral-500 line-clamp-2">{a.data.resume}</p>
                  <time class="text-[]-neutral-600 mt-3 block">
                    {new Date(a.data.date_publication).toLocaleDateString("fr-FR", { day: "numeric", month: "short", year: "numeric" })}
                  </time>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

</Layout>
