---
/**
 * Header — sticky, identical across every page.
 * - Non-scrolled state: 
 *   - Row 1 (above logo): Burger, Search Bar, Promos & Magasins.
 *   - Row 2: Large Centered Logo with a custom ethnic wave background.
 *   - Row 3: Centered Category Buttons.
 * - Scrolled state:
 *   - Row 1 stays sticky.
 *   - Row 2 (Logo) collapses smoothly.
 *   - Row 3 (Categories) becomes sticky, categories align to the left and auxiliary links slide down to the same line on the right.
 * - Category buttons have solid deep colored backgrounds, white text, and correct padding (no text wrapping).
 */
import { RAYONS_LIST } from "@/lib/site";

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);

// Deep, rich shades matching each rayon for button backgrounds (ensures text-white is fully legible)
const BUTTON_COLORS: Record<string, string> = {
  "boucherie-halal": "#8B1919",     // Bordeaux
  "fruits-legumes": "#2E8B4A",      // Vert Primeur
  "epices-du-monde": "#A86B1E",     // Or profond
  "saveurs-afrique": "#A85710",     // Orange profond
  "saveurs-asie": "#A82F24",        // Rouge Asie
  "saveur-mediterranee": "#1E5A8F", // Bleu Méditerranée
};
---

<header
  id="site-header"
  class="sticky top-0 z-50 w-full bg-white/95 backdrop-blur-md border-b border-black/5 transition-all duration-300"
>
  <!-- 0. Row 0: Top bar discrete (Desktop only, slides up on scroll) -->
  <div id="header-top-bar" class="header-top-bar border-b border-black/5 bg-white overflow-hidden">
    <div class="container-mo flex items-center justify-between py-2 text-[12px] text-neutral-500 font-pro">
      <span class="flex items-center gap-2">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-vert animate-pulse"></span>
        Bienvenue chez <strong class="text-neutral-900 font-bold">Marché de Mo'</strong>
        · Le plus grand supermarché ethnique d'Occitanie
      </span>
      <nav class="flex items-center gap-5">
        <a href="/recettes" class="hover:text-vert font-bold text-neutral-600 transition-colors">Recettes</a>
        <a href="/actualites" class="hover:text-vert font-bold text-neutral-600 transition-colors">Actualités</a>
        <a href="/recrutement" class="hover:text-vert font-bold text-neutral-600 transition-colors">Recrutement</a>
        <a href="/programme-fidelite" class="hover:text-vert font-bold text-neutral-600 transition-colors">Fidélité</a>
        <span class="h-3 w-px bg-neutral-200"></span>
        <a href="/notre-enseigne" class="hover:text-vert transition-colors">À propos</a>
        <a href="/service-client" class="hover:text-vert transition-colors">Service client</a>
      </nav>
    </div>
  </div>

  <!-- 1. Row 1: Sticky Navigation Bar (Search, Burger, Promos & Magasins) -->
  <div class="container-mo py-3 relative z-10">
    <!-- Desktop Layout (Hidden on Mobile/Tablet) -->
    <div class="hidden lg:flex items-center justify-between gap-6">
      <!-- Left: Scrolled Logo & Burger Menu -->
      <div class="flex items-center shrink-0">
        <a
          href="/"
          id="header-scrolled-logo"
          title="Retour à l'accueil"
        >
          <img
            src="/logos/logo-marchedemo-rond-contourgreen.png"
            alt="Marché de Mo'"
            width="50"
            height="50"
            class="w-[50px] h-[50px] object-contain shrink-0"
          />
          <div class="flex flex-col text-left font-soft shrink-0 ml-2.5">
            <span class="text-[16px] font-black text-vert-dark leading-none">Marché de Mo'</span>
            <span class="text-[10px] font-bold text-neutral-400 mt-1 leading-none uppercase tracking-wider">Saveurs du monde</span>
          </div>
        </a>
        <button
          id="burger-btn"
          aria-label="Ouvrir le menu"
          class="burger-btn px-4 py-2.5 rounded-full hover:bg-neutral-100 transition text-neutral-800 flex items-center gap-2.5 border border-black/10 bg-white shadow-sm shrink-0"
        >
          <div class="burger-icon relative w-5 h-3.5 flex flex-col justify-between shrink-0">
            <span class="bar bar-1 w-full h-[2px] bg-neutral-800 rounded transition-all duration-300"></span>
            <span class="bar bar-2 w-full h-[2px] bg-neutral-800 rounded transition-all duration-300"></span>
            <span class="bar bar-3 w-full h-[2px] bg-neutral-800 rounded transition-all duration-300"></span>
          </div>
          <span class="burger-text text-[13px] font-soft font-bold">Menu</span>
        </button>
      </div>

      <!-- Center: Search Bar -->
      <form action="/recherche" method="get" class="flex-1 max-w-[620px] relative">
        <input
          type="text"
          name="q"
          placeholder="Rechercher un produit, une saveur, une recette..."
          class="w-full pl-12 pr-20 py-3 bg-neutral-100 focus:bg-white text-[14px] text-neutral-800 rounded-full border border-black/10 focus:border-vert/30 focus:ring-4 focus:ring-vert/5 outline-none transition-all placeholder-neutral-400"
        />
        <svg class="w-5 h-5 text-neutral-400 absolute left-4 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.35-4.35" stroke-linecap="round" />
        </svg>
        <button type="submit" class="absolute right-1.5 top-1/2 -translate-y-1/2 px-4 py-1.5 bg-vert hover:bg-vert-dark text-white text-[12px] font-bold rounded-full transition-colors">
          Valider
        </button>
      </form>

      <!-- Right: Promos & Magasins -->
      <div class="flex items-center gap-3 shrink-0">
        <a
          href="/promos"
          class="px-4 py-2 bg-rouge text-white rounded-full font-soft font-bold text-[13px] flex items-center gap-1.5 transition hover:bg-rouge-dark hover:-translate-y-0.5 shadow-sm"
        >
          <span class="relative flex h-1.5 w-1.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
            <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-white"></span>
          </span>
          Promos
        </a>
        <a
          href="/magasins"
          class="px-4 py-2 border border-vert text-vert hover:bg-vert hover:text-white rounded-full font-soft font-bold text-[13px] flex items-center gap-1.5 transition hover:-translate-y-0.5"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          Magasins
        </a>
      </div>
    </div>

    <!-- Mobile/Tablet Layout (Hidden on Desktop) -->
    <div class="flex flex-col lg:hidden gap-3">
      <div class="flex items-center justify-between">
        <!-- Burger menu & small logo -->
        <div class="flex items-center gap-2">
          <button
            id="burger-btn-mobile"
            aria-label="Ouvrir le menu"
            class="burger-btn p-3 rounded-full hover:bg-black/5 transition text-neutral-800 border border-black/10 bg-white shadow-sm flex items-center justify-center shrink-0"
          >
            <div class="burger-icon relative w-5 h-3.5 flex flex-col justify-between shrink-0">
              <span class="bar bar-1 w-full h-[2px] bg-neutral-800 rounded transition-all duration-300"></span>
              <span class="bar bar-2 w-full h-[2px] bg-neutral-800 rounded transition-all duration-300"></span>
              <span class="bar bar-3 w-full h-[2px] bg-neutral-800 rounded transition-all duration-300"></span>
            </div>
          </button>
          <a href="/" class="flex items-center gap-2">
            <img
              src="/logos/logo-marchedemo-rond-contourgreen.png"
              alt="Marché de Mo'"
              width="40"
              height="40"
              class="w-9 h-9 object-contain"
            />
            <span class="font-soft font-bold text-[15px] text-vert-dark">Marché de Mo'</span>
          </a>
        </div>
        <!-- Promos & Magasins icons -->
        <div class="flex items-center gap-1.5">
          <a
            href="/promos"
            class="px-3 py-1.5 bg-rouge text-white rounded-full font-soft font-bold text-[11px] flex items-center gap-1 shadow-sm"
          >
            Promos
          </a>
          <a
            href="/magasins"
            class="p-1.5 border border-vert text-vert hover:bg-vert hover:text-white rounded-full transition"
            title="Magasins"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
          </a>
        </div>
      </div>
      <!-- Search bar full width on mobile -->
      <form action="/recherche" method="get" class="w-full relative">
        <input
          type="text"
          name="q"
          placeholder="Rechercher un produit, une saveur, une recette..."
          class="w-full pl-10 pr-16 py-2 bg-neutral-100 focus:bg-white text-[13.5px] text-neutral-800 rounded-full border border-black/5 outline-none transition-all placeholder-neutral-400"
        />
        <svg class="w-4 h-4 text-neutral-400 absolute left-3 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.35-4.35" stroke-linecap="round" />
        </svg>
        <button type="submit" class="absolute right-1 top-1/2 -translate-y-1/2 px-3 py-1 bg-vert text-white text-[11px] font-bold rounded-full">
          Valider
        </button>
      </form>
    </div>
  </div>

  <!-- 2. Row 2: Large Centered Logo with wave background (Hides on scroll) -->
  <div 
    id="header-logo-row" 
    class="header-logo-row w-full flex flex-col items-center overflow-hidden"
    style="background: radial-gradient(circle at center, rgba(46, 139, 74, 0.05) 0%, rgba(255, 255, 255, 0) 80%), url('data:image/svg+xml,%3Csvg width=\'120\' height=\'24\' viewBox=\'0 0 120 24\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cpath d=\'M0 12 Q 30 0, 60 12 T 120 12\' fill=\'none\' stroke=\'%231c6b35\' stroke-width=\'1.5\' stroke-opacity=\'0.04\'/%3E%3C/svg%3E') repeat;"
  >
    <a href="/" class="group flex flex-col items-center py-4">
      <img
        src="/logos/logo-marchedemo-rond-contourgreen.png"
        alt="Marché de Mo'"
        width="110"
        height="110"
        fetchpriority="high"
        class="w-24 h-24 lg:w-28 lg:h-28 object-contain filter drop-shadow-md group-hover:scale-105 transition-transform duration-300"
      />
    </a>
  </div>

  <!-- 3. Row 3: Category Buttons & Auxiliary Links (Sticky below Row 1) -->
  <div id="header-categories-row" class="border-t border-black/5 bg-neutral-50/80 py-2.5 transition-all duration-300 relative z-10">
    <div id="header-categories-flex" class="container-mo flex items-center gap-6 transition-all duration-300">
      <!-- Scrollable category tabs bar (Centered by default in top state) -->
      <div 
        id="header-categories-container" 
        class="overflow-x-auto whitespace-nowrap scrollbar-hide flex items-center gap-3 py-1 transition-all duration-300"
      >
        {RAYONS_LIST.slice(0, 6).map((r) => {
          const bgCol = BUTTON_COLORS[r.slug] || BUTTON_COLORS["fruits-legumes"];
          return (
            <a
              href={`/rayons/${r.slug}`}
              class="group/tab inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-[13px] font-soft font-bold text-white transition-all shadow-[0_3px_8px_rgba(0,0,0,0.06)] hover:-translate-y-[1px] hover:scale-[1.02] shrink-0"
              style={`background-color: ${bgCol}; box-shadow: 0 4px 10px ${bgCol}25;`}
            >
              <span class="w-1.5 h-1.5 rounded-full bg-white/40 group-hover/tab:bg-white transition-colors shrink-0"></span>
              <span class="whitespace-nowrap">{r.nomCourt}</span>
            </a>
          );
        })}
      </div>

      <!-- Scrolled auxiliary links (slides/fades in on scroll on desktop) -->
      <div
        id="header-scrolled-links"
        class="hidden items-center gap-5 text-[13.5px] font-soft font-bold text-neutral-500 font-pro shrink-0 transition-all duration-300 opacity-0 translate-x-5 pointer-events-none"
      >
        <a href="/recettes" class="hover:text-vert transition-colors">Recettes</a>
        <a href="/actualites" class="hover:text-vert transition-colors">Actualités</a>
        <a href="/recrutement" class="hover:text-vert transition-colors">Recrutement</a>
        <a href="/programme-fidelite" class="hover:text-vert transition-colors">Fidélité</a>
      </div>
    </div>
  </div>

  <!-- Mobile & Desktop Overlay Drawer (Position absolute to overlay the page content smoothly) -->
  <div
    id="mobile-drawer"
    class="absolute top-full left-0 w-full bg-white border-b border-t border-black/10 shadow-2xl max-h-[85vh] overflow-y-auto z-45"
  >
    <nav class="container-mo py-6 space-y-1.5 font-pro font-semibold text-[15px]">
      <a href="/" class="block py-2.5 border-b border-black/5">Accueil</a>
      <a href="/notre-enseigne" class="block py-2.5 border-b border-black/5">Notre enseigne</a>

      <details class="border-b border-black/5">
        <summary class="py-2.5 cursor-pointer flex justify-between items-center">
          Nos rayons <span class="text-vert">+</span>
        </summary>
        <div class="pl-3 pb-2 space-y-1">
          <a href="/rayons" class="block py-1.5 text-[14px] font-bold text-neutral-900">
            Tous les rayons →
          </a>
          <a href="/produits" class="block py-1.5 text-[14px] font-bold text-vert">
            Tous les produits →
          </a>
          <span class="block h-px bg-black/5 my-1"></span>
          {RAYONS_LIST.map((r) => (
            <a href={`/rayons/${r.slug}`} class="block py-1.5 text-[14px] font-normal text-neutral-700">
              {r.nom}
            </a>
          ))}
        </div>
      </details>

      <a href="/promos" class="block py-2.5 border-b border-black/5 text-rouge font-bold">Promos</a>
      <a href="/magasins" class="block py-2.5 border-b border-black/5">Magasins</a>
      <a href="/recettes" class="block py-2.5 border-b border-black/5">Recettes</a>
      <a href="/recrutement" class="block py-2.5 border-b border-black/5">Recrutement</a>
      <a href="/programme-fidelite" class="block py-2.5 border-b border-black/5">Programme fidélité</a>
      <a href="/actualites" class="block py-2.5 border-b border-black/5">Actualités</a>
      <a href="/service-client" class="block py-2.5 border-b border-black/5">Service client</a>
      <a href="/recherche" class="block py-2.5 border-b border-black/5 text-vert">
        🔍 Rechercher
      </a>

      <a href={`tel:0582958252`} class="mt-4 btn btn-primary w-full">
        Nous appeler — 05 82 95 82 52
      </a>
    </nav>
  </div>
</header>

<style>
  /* Stationary and scrolled heights for fluid scroll transition */
  .header-top-bar {
    max-height: 40px;
    opacity: 1;
    transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease, border-color 0.4s ease;
  }
  .header-logo-row {
    max-height: 160px;
    opacity: 1;
    transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease, padding 0.4s ease;
  }

  #header-scrolled-logo {
    display: flex;
    align-items: center;
    width: 0px;
    opacity: 0;
    margin-right: 0px;
    pointer-events: none;
    overflow: hidden;
    white-space: nowrap;
    transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease, margin-right 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .is-scrolled #header-scrolled-logo {
    width: 195px;
    opacity: 1;
    margin-right: 16px;
    pointer-events: auto;
  }

  /* Hamburger button & icon animation */
  .burger-btn {
    position: relative;
    cursor: pointer;
  }
  .burger-icon {
    position: relative;
    width: 20px;
    height: 14px;
  }
  .burger-icon .bar {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: currentColor;
    border-radius: 4px;
    transform-origin: center center;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;
  }
  .burger-icon .bar-1 {
    top: 0px;
  }
  .burger-icon .bar-2 {
    top: 6px;
  }
  .burger-icon .bar-3 {
    top: 12px;
  }

  .burger-btn.is-active .bar-1 {
    transform: translateY(6px) rotate(45deg);
  }
  .burger-btn.is-active .bar-2 {
    opacity: 0;
    transform: scaleX(0);
  }
  .burger-btn.is-active .bar-3 {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Mobile Drawer slide-down and fade-in transition */
  #mobile-drawer {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-12px);
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.3s;
  }
  #mobile-drawer.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  /* Native details element smooth expansion */
  details[open] summary ~ * {
    animation: sweep-details 0.25s ease-out;
  }
  @keyframes sweep-details {
    0% { opacity: 0; transform: translateY(-4px) }
    100% { opacity: 1; transform: translateY(0) }
  }

  /* Default categories alignment (Centered on desktop, left-aligned/scrollable on mobile) */
  #header-categories-flex {
    justify-content: center;
  }
  #header-categories-container {
    justify-content: flex-start;
    flex: 1;
  }
  #header-scrolled-links {
    display: none !important;
  }

  @media (min-width: 1024px) {
    #header-categories-container {
      justify-content: center;
      flex: none;
    }
  }

  /* Scrolled State Styles */
  .is-scrolled .header-top-bar {
    max-height: 0px !important;
    opacity: 0 !important;
    border-bottom-width: 0px !important;
    pointer-events: none;
  }
  .is-scrolled .header-logo-row {
    max-height: 0px !important;
    opacity: 0 !important;
    padding-top: 0px !important;
    padding-bottom: 0px !important;
    pointer-events: none;
  }

  .is-scrolled #header-categories-flex {
    justify-content: space-between !important;
  }
  @media (min-width: 1024px) {
    .is-scrolled #header-categories-container {
      justify-content: flex-start !important;
    }
    .is-scrolled #header-scrolled-links {
      display: flex !important;
    }
  }
</style>

<script>
  const setupHeader = () => {
    const burger = document.getElementById("burger-btn");
    const burgerMobile = document.getElementById("burger-btn-mobile");
    const drawer = document.getElementById("mobile-drawer");
    const header = document.getElementById("site-header");
    const scrolledLinks = document.getElementById("header-scrolled-links");

    const toggleMenu = (e: MouseEvent) => {
      e.stopPropagation();
      const isOpen = drawer?.classList.toggle("is-open");
      if (isOpen) {
        burger?.classList.add("is-active");
        burgerMobile?.classList.add("is-active");
      } else {
        burger?.classList.remove("is-active");
        burgerMobile?.classList.remove("is-active");
      }
    };
    
    // Guard against duplicate listener binding
    if (burger && !burger.dataset.listenerAttached) {
      burger.dataset.listenerAttached = "true";
      burger.addEventListener("click", toggleMenu as EventListener);
    }

    if (burgerMobile && !burgerMobile.dataset.listenerAttached) {
      burgerMobile.dataset.listenerAttached = "true";
      burgerMobile.addEventListener("click", toggleMenu as EventListener);
    }

    // Click outside to close drawer (Only bind once globally)
    if (!(window as any).__clickOutsideBound) {
      (window as any).__clickOutsideBound = true;
      document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (drawer && drawer.classList.contains("is-open")) {
          const clickedInsideHeader = header?.contains(target);
          if (!clickedInsideHeader) {
            drawer.classList.remove("is-open");
            burger?.classList.remove("is-active");
            burgerMobile?.classList.remove("is-active");
          }
        }
      });
    }

    // Throttled scroll adaptation with requestAnimationFrame
    let ticking = false;
    const onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          if (!header) return;
          
          if (window.scrollY > 40) {
            header.classList.add("is-scrolled", "shadow-[0_4px_20px_rgba(0,0,0,0.06)]");
            if (scrolledLinks) {
              scrolledLinks.classList.remove("opacity-0", "translate-x-5", "pointer-events-none");
              scrolledLinks.classList.add("opacity-100", "translate-x-0");
            }
          } else {
            header.classList.remove("is-scrolled", "shadow-[0_4px_20px_rgba(0,0,0,0.06)]");
            if (scrolledLinks) {
              scrolledLinks.classList.add("opacity-0", "translate-x-5", "pointer-events-none");
              scrolledLinks.classList.remove("opacity-100", "translate-x-0");
            }
          }
          ticking = false;
        });
        ticking = true;
      }
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  };

  // Global ⌘K / Ctrl+K search shortcut (Bind exactly once globally)
  if (!(window as any).__searchShortcutBound) {
    (window as any).__searchShortcutBound = true;
    window.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        if (window.location.pathname.startsWith("/recherche")) return;
        e.preventDefault();
        window.location.href = "/recherche";
      }
    });
  }

  document.addEventListener("astro:page-load", setupHeader);
  if (document.readyState !== "loading") setupHeader();
  else document.addEventListener("DOMContentLoaded", setupHeader);
</script>
