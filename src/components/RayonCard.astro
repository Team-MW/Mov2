---
/**
 * RayonCard — card vitrine d'un rayon, utilisée sur la home et /rayons.
 *
 * Aspect ratios :
 *   - mobile : 4/3 (landscape stacké)
 *   - desktop small (1 col) : 4/5 (portrait)
 *   - desktop large (2 cols) : 8/5 (landscape, MÊME hauteur que small → grid aligné)
 *   Math : small h = w × 5/4 ; large h = 2w × 5/8 = 1.25 w. ✓
 *
 * Slideshow :
 *   - Si `rayon.heroSlideshow` contient ≥ 2 entrées → crossfade CSS automatique
 *     (clés .rayon-slideshow dans global.css, 4 s par image + 0.5 s fade).
 *   - Sinon → `<img>` statique.
 */
import type { Rayon } from "@/lib/site";

interface Props {
  rayon: Rayon;
  large?: boolean;
}

const { rayon, large = false } = Astro.props as Props;
const accent = rayon.accent ?? "#1C6B35";
const accentInk = rayon.accentInk ?? "#FFFFFF";

/* Filtrer heroSlideshow : ≥ 2 entrées uniques → activer carousel */
const uniqueSlides = Array.from(new Set(rayon.heroSlideshow ?? []));
const slideshowActive = uniqueSlides.length >= 2;
const slideCount = Math.min(uniqueSlides.length, 4);
---

<a
  href={`/rayons/${rayon.slug}`}
  class={`group relative overflow-hidden rounded-lg bg-neutral-200 ${
    large ? "md:col-span-2 md:aspect-[8/5]" : "md:aspect-[4/5]"
  } aspect-[4/3]`}
>
  <div class="absolute inset-0 overflow-hidden">
    {slideshowActive ? (
      <div
        class="rayon-slideshow absolute inset-0 w-full h-full"
        data-slides={slideCount}
        transition:name={`rayon-card-${rayon.slug}`}
      >
        {uniqueSlides.slice(0, 4).map((src, i) => {
          /* Slides 0 + 1 load normally (slide 0 is the LCP frame of
             the card, slide 1 needs to be ready for the 4-second fade).
             Slides 2 + 3 are deferred : only the url goes into
             `data-defer-src`, and a page-level script promotes them
             to real `src` once the card enters the viewport + idle.
             Avoids 12 cards × 4 slides = 48 parallel image requests
             on /rayons first paint ; we only pay for the two frames
             the user actually sees in the first 8 seconds. */
          const defer = i >= 2;
          return (
            <img
              src={defer
                ? "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
                : src}
              data-defer-src={defer ? src : undefined}
              alt={i === 0 ? rayon.imageAlt : ""}
              aria-hidden={i > 0 ? "true" : undefined}
              loading="lazy"
              decoding="async"
              width="1280"
              height="1600"
              class="rayon-slide"
            />
          );
        })}
      </div>
    ) : (
      <img
        src={rayon.image}
        alt={rayon.imageAlt}
        loading="lazy"
        decoding="async"
        width="1280"
        height="1600"
        transition:name={`rayon-card-${rayon.slug}`}
        class="w-full h-full object-cover"
      />
    )}
    <!-- Gradient overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>

    <!-- Content on image -->
    <div class="absolute inset-0 p-6 md:p-8 flex flex-col justify-between">
      <div></div>

      <div>
        <h3
          class="rayon-card-tag"
          style={`--tag-bg: ${accent}; --tag-ink: ${accentInk};`}
        >
          {rayon.nom}
        </h3>
        <p class="mt-2 text-white/85 text-[14px] leading-snug max-w-[34ch]">
          {rayon.tagline}
        </p>

        <div class="mt-4 inline-flex items-center gap-2 text-white font-bold text-[13.5px] group-hover:underline underline-offset-4">
          Découvrir le rayon
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M13 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </div>
    </div>
  </div>
</a>

<style>
  .rayon-card-tag {
    display: inline-block;
    background: var(--tag-bg);
    color: var(--tag-ink);
    font-family: var(--font-body);
    text-transform: none;
    font-weight: 700;
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    padding: 0.35em 0.65em 0.4em;
    transform: rotate(-1.5deg);
    transform-origin: left bottom;
  }
</style>
