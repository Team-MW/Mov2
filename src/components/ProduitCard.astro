---
/**
 * ProduitCard — vitrine sensorielle d'un produit, SANS PRIX.
 *
 * Doctrine : pas de prix affiché (risque juridique de pratique
 * commerciale trompeuse si écart entre prix site et prix magasin).
 * Le prix reste exclusivement sur les promos (datées + cadrées).
 *
 * Layout : image carrée dominante + nom court + pill rayon.
 * Hover : zoom léger image + lift card.
 */
import { RAYONS } from "@/lib/site";
import type { ProduitVedette } from "@/lib/produits-vedettes";
import { supabaseSrcSet } from "@/lib/image-cdn";

interface Props {
  produit: ProduitVedette;
  /** Override destination. Default: /produits/[slug] (detail page). */
  linkTo?: "produit" | "rayon";
}

const { produit, linkTo = "produit" } = Astro.props as Props;
const rayonData = RAYONS[produit.rayon];
// Variante foncée : utilisée en couleur de texte sur fond blanc.
const accent = rayonData?.accentDark ?? rayonData?.accent ?? "#1C6B35";
const href =
  linkTo === "rayon" ? `/rayons/${produit.rayon}` : `/produits/${produit.id}`;

/* Responsive srcset : mobile grid renders these at ~160 px (2-col) to
 * ~240 px (3-col), desktop grid at ~280 px (4-col) to ~360 px (3-col).
 * Accounting for DPR 2-3, 400/600/800 covers 2× phones and 3× desktop
 * retina cleanly. `sizes` mirrors the outer grid breakpoints. */
const { src: produitSrc, srcset: produitSrcset } = supabaseSrcSet(
  produit.image,
  [400, 600, 800],
  { quality: 72 },
);
const produitSizes =
  "(max-width: 640px) 45vw, (max-width: 1024px) 30vw, 22vw";
---

{/* Pas d'image = pas de carte (aucun cadre vide sur le site). */}
{produit.image && (
<a
  href={href}
  class="group relative flex flex-col overflow-hidden rounded-lg bg-white shadow-card hover:shadow-card-hover transition-shadow duration-150"
>
  <div class="relative aspect-square overflow-hidden bg-white">
    {produit.image ? (
      <img
        src={produitSrc}
        srcset={produitSrcset}
        sizes={produitSizes}
        alt={produit.nom}
        loading="lazy"
        decoding="async"
        width="600"
        height="600"
        class="w-full h-full object-cover group-hover:scale-[1.05] transition-transform duration-500"
        onerror="this.closest('.group').remove()"
      />
    ) : null}
    {produit.badge && (
      <span
        class="absolute top-3 left-3 inline-flex items-center px-2.5 py-1 rounded-full bg-white/95 text-[11px] font-pro font-bold tracking-wide uppercase shadow-sm"
        style={`color: ${accent}`}
      >
        {produit.badge}
      </span>
    )}
  </div>

  <div class="p-4 flex flex-col gap-2">
    <h3 class="font-soft font-bold text-[15px] leading-tight text-noir text-balance line-clamp-2 min-h-[2.4em]">
      {produit.nom}
    </h3>
    <div class="flex items-center justify-between gap-2 text-[12px]">
      <span
        class="inline-flex items-center gap-1.5 font-pro font-bold tracking-wide uppercase"
        style={`color: ${accent}`}
      >
        <span class="w-1.5 h-1.5 rounded-full" style={`background: ${accent}`}></span>
        {rayonData?.nomCourt ?? produit.rayon}
      </span>
      {produit.origine && (
        <span class="text-neutral-500 font-pro truncate">{produit.origine}</span>
      )}
    </div>
  </div>
</a>
)}
