---
/**
 * BannerCard — admin-side "spec sheet" card for a single banner.
 *
 * Shows :
 *   - The artwork in portrait orientation (real banner aspect).
 *   - Slug, label, kind badge, tagline.
 *   - Palette swatches (4 dots : from / to / accent / on-light).
 *   - Rayon scope chips (where it appears on the public site) + any
 *     cross-reference rayons (smaller, italicized).
 *
 * The card itself is a link to the FIRST rayon in its scope (so admin
 * QA can hop straight to the public surface). If the banner is
 * transversal (no rayonScope), the link goes to `/rayons` index.
 */
import type { Banner } from "@/lib/banners";
import { RAYONS } from "@/lib/site";

interface Props {
  banner: Banner;
}
const { banner } = Astro.props as Props;
const { slug, label, kind, image, tagline, palette, rayonScope, crossRefRayons } = banner;

/* Determine the "preview link" : where this card sends the admin when
 * clicked. Primary scope wins, then transversal fallback. */
const primaryRayonHref = rayonScope[0] ? `/rayons/${rayonScope[0]}` : "/rayons";

/* Rayon label helper — falls back to slug if the registry drifted. */
function rayonLabel(slugIn: string): string {
  const r = RAYONS[slugIn as keyof typeof RAYONS];
  return r?.nomCourt ?? slugIn;
}

const kindStyles =
  kind === "culture"
    ? { bg: "bg-vert/10", text: "text-vert-dark", label: "Culture" }
    : { bg: "bg-rouge/10", text: "text-rouge", label: "Catégorie" };
---

<article
  class="banner-card group block bg-white rounded-3xl border border-black/5 overflow-hidden shadow-sm"
  data-culture={slug}
>
  <a
    href={primaryRayonHref}
    class="block"
    title={`Voir cette bannière sur le site public — ${primaryRayonHref}`}
  >
    <div
      class="banner-card__thumb relative overflow-hidden aspect-[1/3.4]"
      style={`background: linear-gradient(180deg, ${palette.from}, ${palette.to});`}
    >
      <img
        src={image}
        alt={`Bannière ${label}`}
        loading="lazy"
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover"
        width="200"
        height="680"
      />
    </div>
  </a>

  <div class="p-4 md:p-5 flex flex-col gap-3">
    <!-- Header : kind badge + label + tagline -->
    <div>
      <div class="flex items-center justify-between gap-2 mb-1">
        <span
          class:list={[
            "inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider",
            kindStyles.bg,
            kindStyles.text,
          ]}
        >
          {kindStyles.label}
        </span>
        <code class="text-[10.5px] text-neutral-400 font-mono bg-neutral-100 px-1.5 py-0.5 rounded">
          {slug}
        </code>
      </div>
      <h3 class="font-soft font-bold text-[17px] text-noir leading-tight">{label}</h3>
      <p class="mt-1 text-[12.5px] text-neutral-500 leading-snug">{tagline}</p>
    </div>

    <!-- Palette swatches -->
    <div>
      <p class="text-[10px] text-neutral-400 font-bold uppercase tracking-wider mb-1.5">
        Palette
      </p>
      <div class="flex items-center gap-1.5">
        <span
          class="w-7 h-7 rounded-full ring-1 ring-black/10"
          style={`background: ${palette.from};`}
          title={`from : ${palette.from}`}
          aria-label={`Jeton 'from' : ${palette.from}`}
        ></span>
        <span
          class="w-7 h-7 rounded-full ring-1 ring-black/10"
          style={`background: ${palette.to};`}
          title={`to : ${palette.to}`}
          aria-label={`Jeton 'to' : ${palette.to}`}
        ></span>
        <span
          class="w-7 h-7 rounded-full ring-1 ring-black/10"
          style={`background: ${palette.accent};`}
          title={`accent : ${palette.accent}`}
          aria-label={`Jeton 'accent' : ${palette.accent}`}
        ></span>
        <span
          class:list={[
            "inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold border ml-1",
            palette.text === "light"
              ? "bg-noir text-white border-black/20"
              : "bg-white text-noir border-black/20",
          ]}
          title={`Texte au-dessus du gradient : ${palette.text === "light" ? "blanc" : "noir"}`}
        >
          {palette.text === "light" ? "Texte clair" : "Texte sombre"}
        </span>
      </div>
    </div>

    <!-- Scope -->
    <div>
      <p class="text-[10px] text-neutral-400 font-bold uppercase tracking-wider mb-1.5">
        Affiché sur
      </p>
      {rayonScope.length > 0 ? (
        <div class="flex flex-wrap gap-1.5">
          {rayonScope.map((s) => (
            <a
              href={`/rayons/${s}`}
              class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-vert/10 text-vert-dark text-[11px] font-bold hover:bg-vert/20 transition"
              title={`Voir /rayons/${s}`}
            >
              {rayonLabel(s)}
            </a>
          ))}
        </div>
      ) : (
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-neutral-100 text-neutral-600 text-[11px] font-bold italic">
          Transversal — /rayons
        </span>
      )}
    </div>

    {crossRefRayons && crossRefRayons.length > 0 && (
      <div>
        <p class="text-[10px] text-neutral-400 font-bold uppercase tracking-wider mb-1.5">
          Référencé aussi sur
        </p>
        <div class="flex flex-wrap gap-1.5">
          {crossRefRayons.map((s) => (
            <a
              href={`/rayons/${s}`}
              class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-neutral-100 text-neutral-600 text-[11px] font-medium italic hover:bg-neutral-200 transition"
            >
              {rayonLabel(s)}
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Asset path -->
    <details class="border-t border-black/5 pt-3 mt-1">
      <summary class="cursor-pointer text-[11px] text-neutral-400 font-bold uppercase tracking-wider flex items-center justify-between">
        Détails techniques
        <span class="text-vert">▾</span>
      </summary>
      <dl class="mt-2 grid grid-cols-[max-content_1fr] gap-x-3 gap-y-1 text-[11.5px]">
        <dt class="text-neutral-400">Fichier</dt>
        <dd>
          <code class="bg-neutral-100 px-1.5 py-0.5 rounded font-mono text-[10.5px]">
            {image}
          </code>
        </dd>
        <dt class="text-neutral-400">Data attr</dt>
        <dd>
          <code class="bg-neutral-100 px-1.5 py-0.5 rounded font-mono text-[10.5px]">
            data-culture="{slug}"
          </code>
        </dd>
      </dl>
    </details>
  </div>
</article>

<style>
  .banner-card {
    transition:
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.3s ease;
  }
  .banner-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 36px rgba(0, 0, 0, 0.10);
  }
  .banner-card__thumb img {
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .banner-card:hover .banner-card__thumb img {
    transform: scale(1.04);
  }
  @media (prefers-reduced-motion: reduce) {
    .banner-card,
    .banner-card:hover,
    .banner-card__thumb img,
    .banner-card:hover .banner-card__thumb img {
      transition: none;
      transform: none;
    }
  }
</style>
