---
/**
 * CultureChip — a single vertical "bookmark" banner card.
 *
 * Renders the banner artwork inside a portrait-oriented card with a
 * caption strip (label + tagline) at the bottom. Sets the
 * `--culture-*` CSS custom properties inline so the chip *itself* is
 * tinted with the right palette without depending on the parent
 * data-culture attribute. The chip also stamps `data-culture="<slug>"`
 * on the wrapper so any *descendant* (e.g. an inline badge) can inherit
 * the same palette via the scoped tokens in `cultural-palettes.css`.
 *
 * Variants :
 *   - default : portrait card 1:3.6, caption strip white
 *   - compact : smaller portrait 1:2.8 — used in cross-ref strips
 *     where the chip plays a *narrative* role, not a hero role
 *
 * Accessibility :
 *   - Whole chip is a single <a> with descriptive aria-label
 *   - Image alt names the culture explicitly
 *   - Focus ring uses --culture-accent so it stays on-palette
 *
 * Note on `href` : we link to a hash anchor inside the page
 * (`#culture-<slug>`) rather than a new route, per the design decision
 * to *not* create sub-pages yet. The parent rayon page can place an
 * anchor next to the products it wants the chip to scroll to (e.g. a
 * "Spécialités <culture>" sub-grid). If no such anchor exists, the
 * browser falls back to no-op which is the safest behaviour for an
 * empty taxonomy.
 */
import type { Banner } from "@/lib/banners";

interface Props {
  banner: Banner;
  /** Card variant. Default = primary chip; compact = narrative chip. */
  variant?: "default" | "compact";
  /** Optional extra class for layout-specific overrides. */
  class?: string;
}

const { banner, variant = "default", class: cls } = Astro.props;
const { slug, label, image, tagline, palette } = banner;
const isLight = palette.text === "light";
const textColor = isLight ? "#ffffff" : "#0f0f0f";
---

<a
  href={`#culture-${slug}`}
  class:list={["culture-chip", `culture-chip--${variant}`, cls]}
  data-culture={slug}
  style={`--culture-from: ${palette.from}; --culture-to: ${palette.to}; --culture-accent: ${palette.accent}; --culture-on-light: ${palette.accent}; --culture-text: ${textColor};`}
  aria-label={`Découvrir les saveurs ${label} chez Marché de Mo'`}
>
  <span class="culture-chip__media" aria-hidden="true">
    <span class="culture-chip__media-gradient"></span>
    <img
      src={image}
      alt={`Bannière ${label} — Marché de Mo'`}
      loading="lazy"
      decoding="async"
      width="200"
      height="720"
    />
  </span>
  <span class="culture-chip__caption">
    <span class="culture-chip__label">{label}</span>
    <span class="culture-chip__tagline">{tagline}</span>
    <span class="culture-chip__cta" aria-hidden="true">
      Explorer
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M5 12h14M13 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  </span>
</a>

<style>
  .culture-chip {
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    overflow: hidden;
    position: relative;
    text-decoration: none;
    color: inherit;
    background: linear-gradient(180deg, var(--culture-from), var(--culture-to));
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.10);
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s ease;
    isolation: isolate;
    /* Defensive minimum so the chip never collapses if grid maths
       give it less than a sensible base width. */
    min-width: 0;
  }
  .culture-chip:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.16);
  }
  .culture-chip:focus-visible {
    outline: 3px solid var(--culture-accent);
    outline-offset: 3px;
  }

  .culture-chip__media {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1 / 3.6;
    overflow: hidden;
    background: linear-gradient(180deg, var(--culture-from), var(--culture-to));
  }
  .culture-chip--compact .culture-chip__media {
    aspect-ratio: 1 / 2.8;
  }
  .culture-chip__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .culture-chip:hover .culture-chip__media img {
    transform: scale(1.06);
  }
  /* Subtle bottom-fade so the caption strip feels visually attached
     to the image rather than abruptly stacked. */
  .culture-chip__media-gradient {
    position: absolute;
    inset: auto 0 0 0;
    height: 30%;
    background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.12));
    pointer-events: none;
    z-index: 1;
  }

  .culture-chip__caption {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px 16px;
    background: #ffffff;
    border-top: 3px solid var(--culture-accent);
    position: relative;
    z-index: 2;
  }
  .culture-chip__label {
    font-family: var(--font-soft, inherit);
    font-weight: 900;
    font-size: 17px;
    line-height: 1.05;
    color: var(--culture-accent);
    letter-spacing: -0.015em;
  }
  .culture-chip__tagline {
    font-family: var(--font-pro, inherit);
    font-size: 12px;
    line-height: 1.4;
    color: #525252;
    font-weight: 500;
  }
  .culture-chip__cta {
    margin-top: 6px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-pro, inherit);
    font-size: 12px;
    font-weight: 700;
    color: var(--culture-accent);
    letter-spacing: 0.01em;
    transition: transform 0.25s ease;
  }
  .culture-chip__cta svg {
    width: 12px;
    height: 12px;
    transition: transform 0.25s ease;
  }
  .culture-chip:hover .culture-chip__cta svg {
    transform: translateX(3px);
  }

  /* Mobile : slightly more compressed caption to keep chips legible
     when shown side-by-side in a horizontal scroller. The artwork
     itself remains the visual hero. */
  @media (max-width: 640px) {
    .culture-chip__media {
      aspect-ratio: 1 / 3.2;
    }
    .culture-chip--compact .culture-chip__media {
      aspect-ratio: 1 / 2.6;
    }
    .culture-chip__caption {
      padding: 11px 13px 13px;
    }
    .culture-chip__label {
      font-size: 15px;
    }
    .culture-chip__tagline {
      font-size: 11.5px;
    }
    .culture-chip__cta {
      font-size: 11.5px;
    }
  }

  /* Reduced motion : disable the hover lift + image zoom so we don't
     trigger vestibular discomfort. The card still highlights via the
     focus ring + accent border on hover, just without animation. */
  @media (prefers-reduced-motion: reduce) {
    .culture-chip,
    .culture-chip__media img,
    .culture-chip__cta svg {
      transition: none;
    }
    .culture-chip:hover {
      transform: none;
    }
    .culture-chip:hover .culture-chip__media img,
    .culture-chip:hover .culture-chip__cta svg {
      transform: none;
    }
  }
</style>
