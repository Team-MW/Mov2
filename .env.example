# --- Admin (SSR) ---
# Password to unlock /admin. Set on Vercel dashboard (Project → Settings → Env).
ADMIN_PASSWORD=change-me-in-production
# Session cookie secret — 32+ random chars recommended.
ADMIN_COOKIE_SECRET=change-me-use-a-long-random-string

# --- Newsletter (Brevo) ---
# Create a list on brevo.com, paste the API key + list id here.
BREVO_API_KEY=
BREVO_LIST_ID=

# --- Contact / candidatures ---
# Email address that receives /service-client + /recrutement form submissions.
CONTACT_TO_EMAIL=contact@marchedemo.com
RESEND_API_KEY=

# --- Public URL (used for canonical + sitemap) ---
PUBLIC_SITE_URL=https://marchedemov2.vercel.app

# --- Supabase (backend promos/produits/médias) ---
# Project → Settings → API dans Supabase Studio.
SUPABASE_URL=https://your-project.supabase.co
# Anon (publishable) key — safe pour lecture publique via RLS.
SUPABASE_ANON_KEY=sb_publishable_...
# Service role (secret) key — SERVEUR UNIQUEMENT, bypasse RLS.
# À ajouter uniquement sur Vercel pour /admin et les API routes d'écriture.
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase Image Transformations (perf) ---
# Active la réécriture des URLs `object/public/...` vers
# `render/image/public/...?width=…&quality=…&format=webp` pour servir
# des variantes redimensionnées + ré-encodées en WebP.
# Gain typique : -70 à -95 % de poids sur les promos / produits / hero.
# Requiert que Storage > Settings > Image Transformations soit activé
# dans Supabase Studio (inclus dans le plan Free depuis 2024).
# Si désactivé côté projet, mets cette variable à `off` pour que les
# URLs originales soient servies telles quelles (zéro régression).
# Valeurs : "on" (défaut) | "off"
PUBLIC_SUPABASE_IMAGE_TRANSFORMS=on

# --- Pont vers l'inventaire (Phase 1 du trio) ---
# Connecte le site V2 à la base Supabase de l'app inventaire
# (Gestion_inventaire_marchedemo) pour exposer les articles filmés
# en magasin sur marchedemo.com. Détails : src/lib/inventaire-bridge.ts
# et Gestion_inventaire_marchedemo/TRIO_ROADMAP.md.
#
# Sans ces variables, le bridge reste dormant et le site se comporte
# exactement comme avant — table `produits` curée uniquement. Une fois
# les 2 vars renseignées + la migration 003_trio_bridge.sql exécutée
# dans le projet inventaire, les articles WHERE publie_sur_site=true
# apparaissent automatiquement sur /produits et /rayons/[slug].
#
# Récupérer les valeurs : Supabase Studio du projet INVENTAIRE
# (mbqfsibfsmnagzscrxic) → Project Settings → API → URL + anon key.
INVENTAIRE_SUPABASE_URL=
INVENTAIRE_SUPABASE_ANON_KEY=

# --- Webhook depuis l'inventaire (Phase 3 du trio, futur) ---
# HMAC secret partagé avec V2_WEBHOOK_SECRET côté inventaire.
# Permet à /api/admin/inventory-webhook de vérifier l'authenticité des
# notifications create/update/delete envoyées par l'inventaire.
# Générer : `openssl rand -hex 32`
# Laisser vide tant que la Phase 3 n'est pas implémentée.
INVENTORY_WEBHOOK_SECRET=

# --- Téléphone affiché dans le Header ---
# Sans pourcentage / espaces — sera utilisé tel quel dans tel: URI.
PUBLIC_PHONE=0582958252

# --- Vision AI (Gemini, Groq, Mistral) pour analyse produits ---
# Utilisé par l'inventaire pour l'analyse d'images et reconnaissance de produits.
# Au moins un fournisseur doit être configuré pour que la vision fonctionne.

# Gemini (Google) - Vision + Text
# Clé API: https://aistudio.google.com/app/apikey
# Supporte pool de clés: GEMINI_API_KEY + GEMINI_API_KEY_1..20
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq - Vision + Text (gratuit, haute vitesse)
# Clé API: https://console.groq.com/keys
# Supporte pool de clés: GROQ_API_KEY + GROQ_API_KEY_1..10
GROQ_API_KEY=
GROQ_MODEL=llama-3.2-90b-vision-preview
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# Mistral - Vision + Text (gratuit, 2 req/min limite)
# Clé API: https://console.mistral.ai/api-keys
# Supporte pool de clés: MISTRAL_API_KEY + MISTRAL_API_KEY_1..10
MISTRAL_API_KEY=
MISTRAL_MODEL=pixtral-12b-latest
MISTRAL_TEXT_MODEL=mistral-small-latest

# Google Cloud Vision (OCR, labels, objects - fallback)
# Clé API: https://console.cloud.google.com/apis/credentials
GOOGLE_VISION_API_KEY=
